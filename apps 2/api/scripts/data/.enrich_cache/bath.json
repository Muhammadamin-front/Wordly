": "snàmh"}, {"language": {"code": "scn", "name": "Sicilian"}, "word": "bagnu"}, {"language": {"code": "sk", "name": "Slovak"}, "word": "kúpeľ"}, {"language": {"code": "sk", "name": "Slovak"}, "word": "kúpanie"}, {"language": {"code": "sl", "name": "Slovene"}, "word": "kopel"}, {"language": {"code": "es", "name": "Spanish"}, "word": "baño"}, {"language": {"code": "sv", "name": "Swedish"}, "word": "bad"}, {"language": {"code": "tl", "name": "Tagalog"}, "word": "ligo"}, {"language": {"code": "tl", "name": "Tagalog"}, "word": "paliligo"}, {"language": {"code": "ta", "name": "Tamil"}, "word": "குளியல்"}, {"language": {"code": "te", "name": "Telugu"}, "word": "స్నానము"}, {"language": {"code": "txb", "name": "Tocharian B"}, "word": "laiko"}, {"language": {"code": "tr", "name": "Turkish"}, "word": "banyo"}, {"language": {"code": "tr", "name": "Turkish"}, "word": "yunu"}, {"language": {"code": "ota", "name": "Ottoman Turkish"}, "word": "حمام"}, {"language": {"code": "uk", "name": "Ukrainian"}, "word": "ку́пиль"}, {"language": {"code": "uk", "name": "Ukrainian"}, "word": "купа́ння"}, {"language": {"code": "uk", "name": "Ukrainian"}, "word": "ла́зня"}, {"language": {"code": "vi", "name": "Vietnamese"}, "word": "tắm"}, {"language": {"code": "vi", "name": "Vietnamese"}, "word": "tắm rửa"}, {"language": {"code": "vi", "name": "Vietnamese"}, "word": "tắm gội"}, {"language": {"code": "vi", "name": "Vietnamese"}, "word": "rửa ráy"}, {"language": {"code": "cy", "name": "Welsh"}, "word": "bàth"}], "subsenses": []}, {"definition": "Specifically, bathing by immersing the body in water, rather than through other means, or an instance of this.", "tags": [], "examples": ["Do you prefer baths or showers?"], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "An act of immersing the body in a specified substance, especially for hygiene, pleasure, or wellness, or a facility for this: e.g. mud bath, steam bath.", "tags": [], "examples": [], "quotes": [{"text": "Radio-active baths are said to act favourably in a sexual direction. So too with arsenical springs, cold water treatment, and hydrotherapy.", "reference": "1961, Harry E. Wedeck, Dictionary of Aphrodisiacs, New York: The Citadel Press, page 156:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "The body of liquid one bathes in.", "tags": [], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "eo", "name": "Esperanto"}, "word": "bano"}, {"language": {"code": "fi", "name": "Finnish"}, "word": "kylpy"}], "subsenses": []}, {"definition": "(by extension) A substance or preparation in which something is immersed.", "tags": ["broadly"], "examples": ["a bath of heated sand, ashes, steam, or hot air"], "quotes": [{"text": "He takes the prepared charcoal used by artists, brings it to a white heat, and suddenly plunges it in a bath of mercury, of which the globules instantly penetrate the pores of charcoal, and may be said to metallize it.", "reference": "1879, Th Du Moncel, The Telephone, the Microphone and the Phonograph, Harper, page 166:"}, {"text": "While the yarn is soaking in its water and vinegar bath, I prepare a selection of dyes for my preferred colorway.", "reference": "2026, Katherine Augustine, “Dyeing in the Baking Aisle”, in Spin Off, volume L, number 1, page 35:"}], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "bg", "name": "Bulgarian"}, "word": "баня"}, {"language": {"code": "eo", "name": "Esperanto"}, "word": "bano"}, {"language": {"code": "fi", "name": "Finnish"}, "word": "kylpy"}], "subsenses": []}], "synonyms": ["bain"], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "verb", "pronunciations": [{"type": "ipa", "text": "/bɑːθ/", "tags": []}, {"type": "ipa", "text": "[bɑːθ]", "tags": ["General South African", "Received Pronunciation"]}, {"type": "ipa", "text": "[bäːt̪ʰ]", "tags": ["India", "North"]}, {"type": "ipa", "text": "[bäːt̪]", "tags": ["India", "South"]}, {"type": "ipa", "text": "/bɐːθ/", "tags": ["General Australian", "New Zealand"]}, {"type": "ipa", "text": "/bæθ/", "tags": []}, {"type": "ipa", "text": "[bæθ~bɛəθ~beəθ]", "tags": ["Canada", "US"]}, {"type": "ipa", "text": "[baθ~bäθ]", "tags": ["Ireland", "Northern England", "Scotland"]}], "forms": [{"word": "baths", "tags": ["present", "singular", "third-person"]}, {"word": "bathing", "tags": ["participle", "present"]}, {"word": "bathed", "tags": ["participle", "past"]}, {"word": "bathed", "tags": ["past"]}], "senses": [{"definition": "(transitive, Commonwealth) To wash a person or animal in a bath.", "tags": ["Commonwealth", "transitive"], "examples": [], "quotes": [{"text": "Somewhere to bath the baby: don't invest in a plastic baby bath. The bathroom handbasin is usually a much more convenient place to bath the baby. If your partner is more able, this could be a task he might take on as his, bathing the baby in a basin or plastic bown on the floor.", "reference": "1990, Mukti Jain Campion, The Baby Challenge: A handbook on pregnancy for women with a physical disability., →ISBN, page 41:"}, {"text": "For grooming at home, obviously the choice is yours whether you wish to bath the dog in your own bath or sink, or if you want to buy one specifically for the purpose.", "reference": "2006, Sue Dallas, Diana North, Joanne Angus, Grooming Manual for the Dog and Cat, →ISBN, page 91:"}, {"text": "If you find bathing stressfull during the first six weeks, only bath your baby once or twice a week.", "reference": "2007, Robin Barker, Baby Love, →ISBN, page 179:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(intransitive, informal, Commonwealth) To bathe (oneself); to have a bath.", "tags": ["Commonwealth", "informal", "intransitive"], "examples": [], "quotes": [{"text": "“Oh, dear no, not me; I never bath, ’tis the cat has been bathing, in a warm sea bath; I’ll tell you how I manage: I bought a large pickle-jar, and so I have it filled every morning with hot sea water, proportionate to the thermometerical heat my finger can bear, and that I stile Tink-a-tink’s bath; in which I immerge him all but his head, for a quarter of an hour; and he looks so pretty, and receives so much benefit, you would be surprised.”", "reference": "1815, anonymous author, The Observant Pedestrian Mounted, volume 3:"}, {"text": "A man's home may be handy to the mine, in which case he would not need to lose the bath, but if he lived any distance away he would bath at the mine.", "reference": "1912, James Ward, quotee, “Report on the Royal Commission on Mines”, in Appendix to the Journals of the House of Representatives of New Zealand, Wellington, page 141:"}, {"text": "In a flight of fancy, Millot even wanted to create public bath houses alongside the Seine, so young children could bath in the river’s healthful waters.", "reference": "2007, “Doctors, Regeneration, and the Revolutionary Crucible, 1789-1804”, in Sean M. Quinlan, The Great Nation in Decline (The History of Medicine in Context), Aldershot: Ashgate, →ISBN, page 140:"}, {"text": "Parents would bath after all the children had gone to bed or older children sent into the front room.", "reference": "2017 February 9, “Very Early Spring”, in Jean A. Stockdale, My Spring: Royal Times and Ordinary Lives, Troubador Publishing, →ISBN, page 17:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "noun", "pronunciations": [{"type": "ipa", "text": "/bɑːθ/", "tags": []}, {"type": "ipa", "text": "[bɑːθ]", "tags": ["General South African", "Received Pronunciation"]}, {"type": "ipa", "text": "[bäːt̪ʰ]", "tags": ["India", "North"]}, {"type": "ipa", "text": "[bäːt̪]", "tags": ["India", "South"]}, {"type": "ipa", "text": "/bɐːθ/", "tags": ["General Australian", "New Zealand"]}, {"type": "ipa", "text": "/bæθ/", "tags": []}, {"type": "ipa", "text": "[bæθ~bɛəθ~beəθ]", "tags": ["Canada", "US"]}, {"type": "ipa", "text": "[baθ~bäθ]", "tags": ["Ireland", "Northern England", "Scotland"]}], "forms": [{"word": "baths", "tags": ["plural"]}], "senses": [{"definition": "(historical units of measure) A former Hebrew unit of liquid volume (about 23 L or 6 gallons).", "tags": ["historical"], "examples": ["Ye shall have just balances, and a just ephah, and a just bath. The ephah and the bath shall be of one measure, that the bath may contain the tenth part of an homer, and the ephah the tenth part of an homer: the measure thereof shall be after the homer."], "quotes": [], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "cy", "name": "Welsh"}, "word": "bàth"}], "subsenses": []}], "synonyms": [], "antonyms": []}], "source": {"url": "https://en.wiktionary.org/wiki/bath", "license": {"name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"}}}}