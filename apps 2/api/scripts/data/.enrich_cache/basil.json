[], "quotes": [{"text": "[H]old the edge of your Iron upvvards in your left hand and your VVhet-ſtone in your right, and having firſt ſpit upon your Stone to vvet it, apply it to the Baſil of your Iron, in ſuch a Poſition that it may bear upon the vvhole bredth of the Baſil; and ſo vvorking the Stone over the Baſil, you vvill quickly vvear the courſer grating of the Grind ſtone off the edge on that ſide: […]", "reference": "1678 April 11 – May 11 (Gregorian calendar), Joseph Moxon, “Numb[er] IV. The Art of Joynery.”, in Mechanick Exercises, or The Doctrine of Handy-Works, […], volume I, London: […] Joseph Moxon, published 1678, →OCLC, § 10 (Of Grinding and Whetting the Iron, and Other Edge-tools), pages 71–72:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "verb", "pronunciations": [{"type": "ipa", "text": "/ˈbæz.əl/", "tags": ["Australia", "Canada", "New Zealand", "Received Pronunciation"]}, {"type": "ipa", "text": "/ˈbeɪ.zəl/", "tags": ["Canada", "US"]}], "forms": [{"word": "basils", "tags": ["present", "singular", "third-person"]}, {"word": "basiling", "tags": ["US", "participle", "present"]}, {"word": "basilling", "tags": ["UK", "participle", "present"]}, {"word": "basiled", "tags": ["US", "participle", "past"]}, {"word": "basiled", "tags": ["US", "past"]}, {"word": "basilled", "tags": ["UK", "participle", "past"]}, {"word": "basilled", "tags": ["UK", "past"]}], "senses": [{"definition": "(transitive) To grind the edge of a tool to an acute angle.", "tags": ["transitive"], "examples": [], "quotes": [{"text": "These usually large chisels may have the edge basiled on either the inside or the outside of the 90° angle of the blade.", "reference": "1972, Alex W[inkler] Bealer, “Chiseling”, in Old Ways of Working Wood, Barre, Mass.: Barre Publishing Company, Inc., published March 1976 (2nd printing), →ISBN, page 148:"}], "synonyms": [], "antonym