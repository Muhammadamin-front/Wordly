on:"}, {"text": "The book […] giveth liberty to object any crime against any such as are to be ordered.", "reference": "1571, John Whitgift, Admonition to the Parliament:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(transitive, obsolete) To set before or against; to bring into opposition; to oppose.", "tags": ["obsolete", "transitive"], "examples": ["early 17th century, Edward Fairfax, Godfrey of Bulloigne: or The recovery of Jerusalem.\nOf less account some knight thereto object, / Whose loss so great and harmful can not prove.", "c. 1678, Richard Hooker, a sermon\nsome strong impediment or other objecting itself"], "quotes": [{"text": "Pallas to their eyes / The mist objected, and condens'd the skies.", "reference": "1725, Homer, “Book VIII”, in [William Broome], transl., The Odyssey of Homer. […], volume II, London: […] Bernard Lintot, →OCLC:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": ["demur", "except", "take exception"], "antonyms": []}], "source": {"url": "https://en.wiktionary.org/wiki/object", "license": {"name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"}}}}