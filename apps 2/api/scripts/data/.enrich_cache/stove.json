es": ["to stove a finger"], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "verb", "pronunciations": [{"type": "ipa", "text": "/stəʊv/", "tags": ["Received Pronunciation"]}, {"type": "ipa", "text": "/stoʊv/", "tags": ["General American"]}, {"type": "ipa", "text": "/sʈəʋ/", "tags": []}], "forms": [], "senses": [{"definition": "simple past and past participle of stave", "tags": ["form of", "participle", "past"], "examples": [], "quotes": [{"text": "[A]ye, a stove boat will make me an immortal by brevet.", "reference": "1851 November 14, Herman Melville, chapter 7, in Moby-Dick; or, The Whale, 1st American edition, New York, N.Y.: Harper & Brothers; London: Richard Bentley, →OCLC:"}, {"text": "\"A dead whale or a stove boat!\"", "reference": "1851 November 14, Herman Melville, chapter 36, in Moby-Dick; or, The Whale, 1st American edition, New York, N.Y.: Harper & Brothers; London: Richard Bentley, →OCLC:"}, {"text": "\"Our cracked four-pounders made an awful din / but with one fat ball, the Yank stove us in.\"", "reference": "1981, Stan Rogers, “Barrett's Privateers”, in Fogarty's Cove, Springfield, Ontario: Barn Swallow Records:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}], "source": {"url": "https://en.wiktionary.org/wiki/stove", "license": {"name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"}}}}