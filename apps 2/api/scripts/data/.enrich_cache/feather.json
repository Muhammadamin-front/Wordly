rd": "plüm"}, {"language": {"code": "vo", "name": "Volapük"}, "word": "bödaplüm"}, {"language": {"code": "vo", "name": "Volapük"}, "word": "plümem"}, {"language": {"code": "vo", "name": "Volapük"}, "word": "bödaplümem"}, {"language": {"code": "vo", "name": "Volapük"}, "word": "pen"}, {"language": {"code": "vo", "name": "Volapük"}, "word": "bödapen"}, {"language": {"code": "wa", "name": "Walloon"}, "word": "pene"}, {"language": {"code": "wa", "name": "Walloon"}, "word": "plome"}, {"language": {"code": "wba", "name": "Warao"}, "word": "huhi"}, {"language": {"code": "cy", "name": "Welsh"}, "word": "plu"}, {"language": {"code": "cy", "name": "Welsh"}, "word": "pluf"}, {"language": {"code": "cy", "name": "Welsh"}, "word": "adain"}, {"language": {"code": "yai", "name": "Yaghnobi"}, "word": "бал"}, {"language": {"code": "sah", "name": "Yakut"}, "word": "куорсун"}, {"language": {"code": "yi", "name": "Yiddish"}, "word": "פֿעדער"}, {"language": {"code": "yur", "name": "Yurok"}, "word": "re'noh"}, {"language": {"code": "zza", "name": "Zazaki"}, "word": "purt"}, {"language": {"code": "zea", "name": "Zealandic"}, "word": "plume"}, {"language": {"code": "za", "name": "Zhuang"}, "word": "bwnsienq"}, {"language": {"code": "za", "name": "Zhuang"}, "word": "bwn"}, {"language": {"code": "zu", "name": "Zulu"}, "word": "uphaphe class 11/10"}], "subsenses": []}, {"definition": "Long hair on the lower legs of a dog or horse, especially a draft horse, notably the Clydesdale breed. Narrowly only the rear hair.", "tags": [], "examples": [], "quotes": [], "synonyms": ["feathers", "feathering", "horsefeathers"], "antonyms": ["spats"], "translations": [{"language": {"code": "cs", "name": "Czech"}, "word": "rous"}, {"language": {"code": "fi", "name": "Finnish"}, "word": "vuohiskarva"}, {"language": {"code": "fr", "name": "French"}, "word": "fanon"}, {"language": {"code": "it", "name": "Italian"}, "word": "barbetta"}], "subsenses": []}, {"definition": "One of the fins or wings on the shaft of an arrow.", "tags": [], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "A longitudinal strip projecting from an object to strengthen it, or to enter a channel in another object and thereby prevent displacement sideways or rotationally but permit motion lengthwise.", "tags": [], "examples": ["Near-synonym: spline"], "quotes": [], "synonyms": ["spline"], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "Kind; nature; species (from the proverbial phrase \"birds of a feather\").", "tags": [], "examples": [], "quotes": [{"text": "I am not of that feather to shake off / My friend when he must need me.", "reference": "c. 1605–1608 (date written), William Shakespeare, “The Life of Tymon of Athens”, in Mr. William Shakespeares Comedies, Histories, & Tragedies […] (First Folio), London: […] Isaac Iaggard, and Ed[ward] Blount, published 1623, →OCLC, [Act I, scene i]:"}], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "fi", "name": "Finnish"}, "word": "tyyppi"}, {"language": {"code": "ko", "name": "Korean"}, "word": "유"}, {"language": {"code": "ko", "name": "Korean"}, "word": "종류"}], "subsenses": []}, {"definition": "One of the two shims of the three-piece stone-splitting tool known as plug and feather or plug and feathers; the feathers are placed in a borehole and then a wedge is driven between them, causing the stone to split.", "tags": [], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "The angular adjustment of an oar or paddle-wheel float, with reference to a horizontal axis, as it leaves or enters the water.", "tags": [], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "Anything petty or trifling; a whit or jot.", "tags": [], "examples": [], "quotes": [{"text": "To some pew purchasers he gave deeds, to others he gave, none, but both were promised security, and both it seems were equally secure, for the pew deed as Mr. Melledge declared to Mr. G. was not worth a feather.", "reference": "1823, An Ecclesiastical Memoir of Essex Street Religious Society:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(hunting, in the plural) Partridges and pheasants, as opposed to rabbits and hares (called fur).", "tags": ["in plural"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(rail transport) A junction indicator attached to a colour-light signal at an angle, which lights up, typically with four white lights in a row, when a diverging route is set up.", "tags": [], "examples": [], "quotes": [{"text": "Signal M123 is a conventional 3-aspect colour light with three Junction Indicators - commonly known as 'feathers'.", "reference": "2020 December 30, David Allen, “Unusual signals...: Morpeth Signal M123”, in Rail, page 64:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(cricket) A faint edge.", "tags": [], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": ["plume", "pluma"], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "verb", "pronunciations": [{"type": "ipa", "text": "/ˈfɛð.ə/", "tags": ["Received Pronunciation"]}, {"type": "ipa", "text": "[ˈfɛð.ə]", "tags": ["Received Pronunciation"]}, {"type": "ipa", "text": "/ˈfɛð.ɚ/", "tags": ["General American"]}, {"type": "ipa", "text": "[ˈfɛð.ɚ] ~ [ˈfɛð.ɹ̩]", "tags": ["General American"]}], "forms": [{"word": "feathers", "tags": ["present", "singular", "third-person"]}, {"word": "feathering", "tags": ["participle", "present"]}, {"word": "feathered", "tags": ["participle", "past"]}, {"word": "feathered", "tags": ["past"]}, {"word": "fether", "tags": ["alternative", "archaic"]}], "senses": [{"definition": "To cover or furnish with feathers; (when of an arrow) to fletch.", "tags": [], "examples": [], "quotes": [{"text": "An Eagle had the ill Hap to be Struck with an Arrow Feather'd from her own Wing.", "reference": "1692, Roger L’Estrange, “ (please specify the fable number.) (please specify the name of the fable.)”, in Fables, of Æsop and Other Eminent Mythologists: […], London: […] R[ichard] Sare, […], →OCLC:"}, {"text": "Olondaw had taught Hazeleye how to use her bow and arrows, and that each might know the result of his or her own shooting, he had feathered her arrow with white and his own with red. How strange are the events of this life, […]", "reference": "1912, Frances, Object-lessons on Temperance, Or, The Indian Maiden and Her White Deer, page 117:"}, {"text": "She feathered her arrows in the Seneca fashion, two lengths of feather tied on with a spiral twist, so they would spin in flight. The trick was to glue both sides in place with a little sticky pine sap so they would stay put while she tied them […]", "reference": "2007, Thomas Perry, Vanishing Act, Ballantine Books, →ISBN, page 302:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "To adorn, as if with feathers; to fringe.", "tags": [], "examples": [], "quotes": [{"text": "A few birches and oaks still feathered the narrow ravines, or occupied in dwarf clusters the hollow plains of the moor.", "reference": "1816, Jedadiah Cleishbotham [pseudonym; Walter Scott], chapter II, in Tales of My Landlord, […], volume II (Old Mortality), Edinburgh: […] [James Ballantyne and Co.] for William Blackwood, […]; London: John Murray, […], →OCLC, page 28:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "To arrange in the manner or appearance of feathers.", "tags": [], "examples": ["The stylist feathered my hair."], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(ambitransitive, rowing) To rotate the oars while they are out of the water to reduce wind resistance.", "tags": ["ambitransitive"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "fi", "name": "Finnish"}, "word": "kääntää lappeelleen"}, {"language": {"code": "sw", "name": "Swahili"}, "word": "nyoya"}], "subsenses": []}, {"definition": "(aeronautics) To streamline the blades of an aircraft's propeller by rotating them perpendicular to the axis of the propeller when the engine is shut down so that the propeller does not windmill during flight.", "tags": [], "examples": ["After striking the bird, the pilot feathered the damaged left engine’s propeller."], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(carpentry, engineering) To finely shave or bevel an edge.", "tags": [], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "fi", "name": "Finnish"}, "word": "viistää"}, {"language": {"code": "fi", "name": "Finnish"}, "word": "pontata"}, {"language": {"code": "sw", "name": "Swahili"}, "word": "nyoya"}], "subsenses": []}, {"definition": "(computer graphics) To intergrade or blend the pixels of an image with those of a background or neighboring image.", "tags": [], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(intransitive) Of written or printed ink: to take on a blurry appearance as a result of spreading through the receiving medium.", "tags": ["intransitive"], "examples": [], "quotes": [{"text": "Whether or not the ink feathers depends upon the paper or card, and also upon the nature of the dye in the ink.", "reference": "1940, Circular of the Bureau of Standards, numbers 426-451, page 50:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(transitive) To render light as a feather; to give wings to.", "tags": ["transitive"], "examples": ["c. 1650, Robert Loveday, letter to Mr. C.\nThe Polonian story, which perhaps may feather some tedious hours."], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(transitive) To enrich; to exalt; to benefit.", "tags": ["transitive"], "examples": [], "quotes": [{"text": "They stuck not to say that the king cared not to plume his nobility and people to feather himself.", "reference": "1622, Francis, Lord Verulam, Viscount St. Alban [i.e. Francis Bacon], The Historie of the Raigne of King Henry the Seventh, […], London: […] W[illiam] Stansby for Matthew Lownes, and William Barret, →OCLC:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(transitive) To tread, as a cockerel.", "tags": ["transitive"], "examples": [], "quotes": [{"text": "Ardent in love[…]He feather'd her a hundred times a day.", "reference": "1700, [John] Dryden, “The Cock and the Fox: Or, The Tale of the Nun’s Priest, from Chaucer”, in Fables Ancient and Modern; […], London: […] Jacob Tonson, […], →OCLC:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(snooker, billiards) To move the cue back and forth along the bridge in preparation for striking the cue ball.", "tags": [], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(snooker, billiards) To accidentally touch the cue ball with the tip of the cue when taking aim.", "tags": [], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(transitive) To touch lightly, like (or as if with) a feather.", "tags": ["transitive"], "examples": [], "quotes": [{"text": "His breath feathered her lips; her spine, her legs weakened, went soft at the wafting warmth.", "reference": "2001, Joan Hohl, Maybe Tomorrow, Zebra Books, →ISBN, page 186:"}, {"text": "A soft breeze feathered her face and hair. The smell of honeysuckle blanketed the air. She concentrated on shutting out every sound except the whisper of her heart. Gradually the inner distractions became fewer.", "reference": "2006, Gary Parker, Her Daddy's Eyes, Baker Books, →ISBN, page 143:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(transitive) To move softly, like a feather.", "tags": ["transitive"], "examples": ["She feathered her fingers through Mitchell's hair. “Besides, I like you a whole lot better than Frye.”"], "quotes": [{"text": "“Asking me not to breathe would be simpler,” Drake said. “If I could spare you what's coming—” “No.” Drake feathered her fingers through Sylvan's hair. “We fight together.” Sylvan nodded and relaxed in her embrace. Drake didn't fear death.", "reference": "2011, L.L. Raand, Blood Hunt, Bold Strokes Books Inc, →ISBN:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}], "source": {"url": "https://en.wiktionary.org/wiki/feather", "license": {"name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"}}}}