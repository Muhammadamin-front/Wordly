, "subsenses": []}], "synonyms": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "adverb", "pronunciations": [{"type": "ipa", "text": "/ˈblaɪ̯nd/", "tags": []}, {"type": "ipa", "text": "[ˈblaɪ̯nd]", "tags": []}, {"type": "ipa", "text": "/ˈblaːnd/", "tags": ["General South African", "Southern US"]}, {"type": "ipa", "text": "[ˈblaːnd]", "tags": ["General South African", "Southern US"]}], "forms": [{"word": "more blind", "tags": ["comparative"]}, {"word": "most blind", "tags": ["superlative"]}, {"word": "blinde", "tags": ["alternative", "obsolete"]}], "senses": [{"definition": "Without seeing; unseeingly.", "tags": [], "examples": [], "quotes": [{"text": "It was just robbery with violence, aggravated murder on a great scale, and men going at it blind - as is very proper for those who tackle a darkness.", "reference": "1899 February, Joseph Conrad, “The Heart of Darkness”, in Blackwood’s Edinburgh Magazine, volume CLXV, number M, New York, N.Y.: The Leonard Scott Publishing Company, […], →OCLC, part I, page 196:"}], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "ast", "name": "Asturian"}, "word": "ciego"}, {"language": {"code": "ast", "name": "Asturian"}, "word": "ciegamente"}, {"language": {"code": "eu", "name": "Basque"}, "word": "itsu"}, {"language": {"code": "fi", "name": "Finnish"}, "word": "sokeasti"}, {"language": {"code": "fi", "name": "Finnish"}, "word": "sokkona"}, {"language": {"code": "de", "name": "German"}, "word": "blind"}, {"language": {"code": "el", "name": "Greek"}, "word": "τυφλά"}, {"language": {"code": "it", "name": "Italian"}, "word": "ciecamente"}, {"language": {"code": "ru", "name": "Russian"}, "word": "вслепу́ю"}, {"language": {"code": "es", "name": "Spanish"}, "word": "ciegamente"}], "subsenses": []}, {"definition": "(colloquial) Absolutely, totally.", "tags": ["colloquial"], "examples": ["to swear blind"], "quotes": [{"text": "It was just robbery with violence, aggravated murder on 