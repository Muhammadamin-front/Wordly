uage": {"code": "uz", "name": "Uzbek"}, "word": "marjon"}, {"language": {"code": "uz", "name": "Uzbek"}, "word": "shoda"}, {"language": {"code": "vi", "name": "Vietnamese"}, "word": "chuỗi hạt"}, {"language": {"code": "wym", "name": "Vilamovian"}, "word": "puttynystyn"}, {"language": {"code": "cy", "name": "Welsh"}, "word": "gwddfdorch"}, {"language": {"code": "cy", "name": "Welsh"}, "word": "mwclis"}, {"language": {"code": "cy", "name": "Welsh"}, "word": "neclis"}, {"language": {"code": "wyi", "name": "Woiwurrung"}, "word": "gornbert"}, {"language": {"code": "yag", "name": "Yámana"}, "word": "polesif"}, {"language": {"code": "mch", "name": "Ye'kwana"}, "word": "wo'mo"}, {"language": {"code": "yi", "name": "Yiddish"}, "word": "האַלדזבאַנד"}, {"language": {"code": "yur", "name": "Yurok"}, "word": "ˀekeˀr"}, {"language": {"code": "zu", "name": "Zulu"}, "word": "umgexo"}], "subsenses": []}, {"definition": "(figuratively) Anything resembling a necklace in shape.", "tags": ["figuratively"], "examples": ["a necklace of coral islands"], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(South Africa) A device used in necklacing (an informal execution); a rubber tyre that is filled with petrol. It is placed around the victim's chest and arms, and set on fire.", "tags": ["South Africa"], "examples": ["Necklacing on Wikipedia.Wikipedia"], "quotes": [{"text": "Seven people have been arrested in connection with Saturday's \"necklace\" murder of three men in the Tjokville informal settlement at Jeffrey's Bay.", "reference": "4 August, 2004, “Necklacing: 7 held”, in Headline Pretoria News:"}, {"text": "Several of the alledged witches in Apel and GaNkaone were also subjected to a necklace execution", "reference": "2000, Ineke Van Kessel, Beyond Our Wildest Dreams: The United Democratic Front and the Transformation of South Africa:"}, {"text": "In the fluidly unfolding events of a necklace murder, was there time and space to stop the killing?", "reference": "2004, Pumla Gobodo-Madikizela, A Human Being Died That Night: A South African Woman Confronts the Legacy of Apartheid:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "verb", "pronunciations": [{"type": "ipa", "text": "/ˈnɛkləs/", "tags": ["US"]}, {"type": "ipa", "text": "/ˈnɛklɪs/", "tags": ["UK"]}, {"type": "ipa", "text": "/ˈnɛkləs/", "tags": ["UK"]}, {"type": "ipa", "text": "/ˈnɛkləs/", "tags": ["General Australian"]}, {"type": "ipa", "text": "/ˈnɛklæɪs/", "tags": ["General Australian"]}], "forms": [{"word": "necklaces", "tags": ["present", "singular", "third-person"]}, {"word": "necklacing", "tags": ["participle", "present"]}, {"word": "necklaced", "tags": ["participle", "past"]}, {"word": "necklaced", "tags": ["past"]}], "senses": [{"definition": "(South Africa) To informally execute by necklacing; by setting on fire a petrol-filled rubber tyre which has been put around the bound victim's neck.", "tags": ["South Africa"], "examples": ["2002 Buthelezi: A Biography by Ben Temkin\nInkatha members have been hacked to death and necklaced, and their houses have been destroyed", "2000 Beyond Our Wildest Dreams: The United Democratic Front and the Transformation of South Africa by Ineke Van Kessel\nThe first instance of necklacing occurred in March 1985 in the Eastern Cape township of KwaNobuhle."], "quotes": [{"text": "Frustrated residents tied the hands of two suspected criminals, put tyres around their necks and then set them alight. In a manifestation of growing disillusionment with the criminal justice system, residents of Bramfischerville, west of Johannesburg, on Tuesday abducted and necklaced two suspected burglars.", "reference": "May 29 2003, The Star:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}], "source": {"url": "https://en.wiktionary.org/wiki/ne