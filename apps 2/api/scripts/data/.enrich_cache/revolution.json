}, {"language": {"code": "pl", "name": "Polish"}, "word": "obrót"}, {"language": {"code": "pt", "name": "Portuguese"}, "word": "revolução"}, {"language": {"code": "pt", "name": "Portuguese"}, "word": "rotação"}, {"language": {"code": "pt", "name": "Portuguese"}, "word": "giro"}, {"language": {"code": "ru", "name": "Russian"}, "word": "враще́ние"}, {"language": {"code": "ru", "name": "Russian"}, "word": "оборо́т"}, {"language": {"code": "es", "name": "Spanish"}, "word": "revolución"}, {"language": {"code": "sw", "name": "Swahili"}, "word": "geuza"}, {"language": {"code": "sv", "name": "Swedish"}, "word": "rotation"}, {"language": {"code": "tr", "name": "Turkish"}, "word": "döngü"}, {"language": {"code": "ota", "name": "Ottoman Turkish"}, "word": "اداره"}, {"language": {"code": "ota", "name": "Ottoman Turkish"}, "word": "دوره"}, {"language": {"code": "uk", "name": "Ukrainian"}, "word": "оберта́ння"}, {"language": {"code": "uk", "name": "Ukrainian"}, "word": "верті́ння"}, {"language": {"code": "uk", "name": "Ukrainian"}, "word": "оборо́т"}, {"language": {"code": "uk", "name": "Ukrainian"}, "word": "о́берт"}, {"language": {"code": "wa", "name": "Walloon"}, "word": "toû"}, {"language": {"code": "cy", "name": "Welsh"}, "word": "amdro"}], "subsenses": []}, {"definition": "(astronomy) In the case of celestial bodies, the traversal of one body along an orbit around another body.", "tags": ["countable", "uncountable"], "examples": ["It takes 365 days for the Earth to complete one revolution around the sun."], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "A sudden, vast change in a situation, a discipline, or the way of thinking and behaving.", "tags": ["countable", "uncountable"], "examples": ["the AI revolution"], "quotes": [{"text": "Ông Kac-Mac là kinh tế học K. M. Ông ấy ngiên kứu rõ ràng tư bản chủ ngĩa, dế quốc chủ ngĩa, zai kấp tranh dấu, vân vân ở dâu mà sinh ra; lịch sử nó thế nào, hiện tượng nó thế nào, và kết quả nó sẽ ra thế nào.", "reference": "1927, Nguyễn Ái Quốc, “1. K. M. là zì?”, in Dường Kách mệnh; English translation from “1. What is a Revolution?”, in Vijay Prashad, transl., The Revolutionary Path (Selected Ho Chi Minh), translation of original in Vietnamese, 2022:"}, {"text": "In 1825, the first public railway carried passengers across the English countryside, setting in motion not just an engineering revolution, but an industrial one too. Imagine the awe and excitement of those first passengers as they boarded the train, unaware that they were witnessing the dawn of a new era.", "reference": "2025 October 1, Richard Evans, “The value of the railway effect”, in RAIL, number 1045, page 58:"}], "synonyms": [], "antonyms": ["evolution"], "translations": [], "subsenses": []}, {"definition": "A round of periodic changes, such as between the seasons of the year.", "tags": ["countable", "uncountable"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "Consideration of an idea; the act of revolving something in the mind.", "tags": ["countable", "uncountable"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(card games) a rule in Tycoon where if four cards are placed down at once, the card hierarchy is reversed.", "tags": ["countable", "uncountable"], "examples": [], "quotes": [], "synonyms": [], "antonyms": ["counterrevolution"], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}], "source": {"url": "https://en.wiktionary.org/wiki/revolution", "license": {"name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"}}}}