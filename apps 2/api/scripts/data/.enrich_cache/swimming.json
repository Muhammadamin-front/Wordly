ule”, unnumbered page:"}, {"text": "But when the worms are killed with the aforesaid medicines, you must driue them out without delay : for there proceedeth a vicious exhalation from them, which both destroyeth appetite, and hurteth digestion, and being lifted vpward, it causeth swimmings, and other euils.", "reference": "1624, Philip Barrough, The Method of Physick, Contaning the Cavses, Signes, and Cvres of Inward Diseases in Mans Body, From the Head to the Foote: […], 6th edition, London: Richard Field, page 134:"}, {"text": "[The Speedwell] doth also wonderfully helpe the memory, and to ease all turnings and swimmings, and other paines of the head, and as it is sayd helpeth women to become fruitfull, that were barren[.]", "reference": "1640, John Parkinson, Theatrum Botanicum: The Theater of Plants. Or, an Herball of Large Extent: […], London, page 552:"}, {"text": "Swimmings of the head and intestinal pains seemed the prelude of dissolution.", "reference": "1869, William Chambers, Robert Chambers, Chambers's Miscellany of Instructive & Entertaining Tracts, page 2:"}], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "bg", "name": "Bulgarian"}, "word": "световъртеж"}, {"language": {"code": "nl", "name": "Dutch"}, "word": "duizeling"}, {"language": {"code": "el", "name": "Greek"}, "word": "ζάλη"}, {"language": {"code": "el", "name": "Greek"}, "word": "ίλιγγος"}, {"language": {"code": "mi", "name": "Māori"}, "word": "pōnitiniti"}, {"language": {"code": "ang", "name": "Old English"}, "word": "swima"}], "subsenses": []}], "synonyms": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "verb", "pronunciations": [{"type": "ipa", "text": "/ˈswɪmɪŋ/", "tags": []}, {"type": "ipa", "text": "/ˈswɪmiŋ/", "tags": []}], "forms": [], "senses": [{"definition": "present participle and gerund of swim", "tags": ["form of", "gerund", "participle", "present"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "transl