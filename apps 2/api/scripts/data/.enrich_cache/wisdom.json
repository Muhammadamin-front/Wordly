: [], "translations": [{"language": {"code": "hy", "name": "Armenian"}, "word": "իմաստություն"}, {"language": {"code": "chr", "name": "Cherokee"}, "word": "ᎠᎦᏙᎲᏍᏗ"}, {"language": {"code": "da", "name": "Danish"}, "word": "visdom"}, {"language": {"code": "nl", "name": "Dutch"}, "word": "wijsheid"}, {"language": {"code": "et", "name": "Estonian"}, "word": "tarkus"}, {"language": {"code": "fi", "name": "Finnish"}, "word": "viisaus"}, {"language": {"code": "fr", "name": "French"}, "word": "sagesse"}, {"language": {"code": "ka", "name": "Georgian"}, "word": "სიბრძნე"}, {"language": {"code": "de", "name": "German"}, "word": "Weisheit"}, {"language": {"code": "he", "name": "Hebrew"}, "word": "חוכמה \\ חָכְמָה"}, {"language": {"code": "hu", "name": "Hungarian"}, "word": "bölcsesség"}, {"language": {"code": "io", "name": "Ido"}, "word": "sajeso"}, {"language": {"code": "it", "name": "Italian"}, "word": "saggezza"}, {"language": {"code": "ja", "name": "Japanese"}, "word": "英知"}, {"language": {"code": "ja", "name": "Japanese"}, "word": "知識"}, {"language": {"code": "lv", "name": "Latvian"}, "word": "gudrība"}, {"language": {"code": "no", "name": "Norwegian"}, "word": "visdom"}, {"language": {"code": "pt", "name": "Portuguese"}, "word": "sabedoria"}, {"language": {"code": "ru", "name": "Russian"}, "word": "му́дрость"}, {"language": {"code": "es", "name": "Spanish"}, "word": "sabiduría"}, {"language": {"code": "sw", "name": "Swahili"}, "word": "hekima"}, {"language": {"code": "tr", "name": "Turkish"}, "word": "hikmet"}], "subsenses": []}, {"definition": "(rare) A group of wombats.", "tags": ["countable", "rare", "uncountable"], "examples": [], "quotes": [{"text": "It would also be difficult to get to the bottom line accurately if a wisdom of wombats ate your working papers. Both scenarios are equal in probability.", "reference": "2007 April 16, Tony Cooper, “Ebay is Unfair!”, in rec.collecting.coins (Usenet), retrieved 05 Sep 2022:"}, {"text": "Beautimus strolled to the river for her morning bath. She looked one direction, then the other to search the landscape for anything or anybody who might offer a clue as to what could be coming her way. She passed a pond where a congregation of alligators and a wisdom of wombats engaged in a heated argument over economics. Nothing unusual in that.", "reference": "2017, Peggy A. Wheeler, The Splendid and Extraordinary Life of Beautimus Potamus:"}, {"text": "Banyule means hill, another voice whispers from the swamp, and as I turn to ask a question I see kangaroos lying in the shade of a low tree by the shining water. Yes, the water has returned, along with giant earth-eating creatures boring holes far below, linking wisdoms of wombats with wastelands of Winthers.", "reference": "2020, Graham Jackson, The7th Victim, page 160:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(rare) A group of owls.", "tags": ["countable", "rare", "uncountable"], "examples": [], "quotes": [{"text": "What he expected to find I cannot imagine , unless it was a wisdom of owls. What he did see and hear were telephones ringing, assistants answering them, getting up from their seats to take a book or a card from a file, returning[…]", "reference": "1974, Margery Weiner, Answering Any Questions: How to Set Up an Information Office, Newton Abbot : David and Charles [for] the \"Daily Telegraph\":"}, {"text": "All of us, whether we gather into a wisp of snipes, a wisdom of owls, a wing of plovers, or remain like a single regretful priest on his knees before his God, we are one and it is not for us to decide another's fate.", "reference": "2016, Gary Barwin, Yiddish for Pirates: A Novel, →ISBN, page 91:"}], "synonyms": ["parliament"], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(countable, colloquial) Ellipsis of wisdom tooth.", "tags": ["abbreviation", "alt of", "colloquial", "countable", "ellipsis"], "examples": [], "quotes": [{"text": "HAVING MY WISDOMS REMOVED", "reference": "2003, Harry Gilleland, Poetry for the Common Man, page 149:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": ["acuity", "astuteness", "clairvoyance", "discernment", "discrimination", "gumption", "insight", "nous", "penetration", "perspicacity", "prudence", "sagaciousness", "sagacity", "sageliness", "sageness", "sapience", "savvy", "sharpness", "sophy", "understanding", "wisdom", "wiseness", "wit"], "antonyms": ["foolishness", "folly", "foolhardiness", "imprudence", "stupidity", "unwisdom"]}], "source": {"url": "https://en.wiktionary.org/wiki/wisdom", "license": {"name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"}}}}