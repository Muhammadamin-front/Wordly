ish"}, "partOfSpeech": "noun", "pronunciations": [{"type": "ipa", "text": "/ˈvɜː.bəl/", "tags": ["General Australian", "Received Pronunciation"]}, {"type": "ipa", "text": "[ˈvɜː.bɫ̩]", "tags": ["General Australian", "Received Pronunciation"]}, {"type": "ipa", "text": "/ˈvɝ.bəl/", "tags": ["Canada", "General American"]}, {"type": "ipa", "text": "[ˈvɝ.bɫ̩]", "tags": ["Canada", "General American"]}], "forms": [{"word": "verbals", "tags": ["plural"]}], "senses": [{"definition": "(countable, grammar) A verb form which does not function as a predicate, or a word derived from a verb. In English, infinitives, participles and gerunds are verbals.", "tags": ["countable"], "examples": [], "quotes": [], "synonyms": ["non-finite verb"], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(countable, UK, Ireland) A spoken confession given to police.", "tags": ["Ireland", "UK", "countable"], "examples": [], "quotes": [{"text": "They were convicted on the evidence of an agent provocateur named Richard Seary, backed up by police verbals from three police officers who gave evidence of six verbals in which the three accused were supposed to have admitted their guilt.", "reference": "1982, New South Wales. Parliament, Parliamentary Debates, page 2496:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(uncountable, UK, Ireland, colloquial) Talk; speech, especially banter or scolding.", "tags": ["Ireland", "UK", "colloquial", "uncountable"], "examples": [], "quotes": [{"text": "We'd give him a bit of verbal, out would come the bouncers, chucking their weight about, and it would all end in a right tear-up.", "reference": "2013, Lenny McLean, The Guv'nor:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "verb", "pronunciations": [{"type": "ipa", "text": "/ˈvɜː.bəl/", "tags": ["General Australian", "Received Pronunciation"]}, {"type": "ipa", "text": "[ˈvɜː.bɫ̩]", "tags": ["General Australian", "Received Pronunciation"]}, {"type": "ipa", "text": "/ˈvɝ.bəl/", "tags": ["Canada", "General American"]}, {"type": "ipa", "text": "[ˈvɝ.bɫ̩]", "tags": ["Canada", "General American"]}], "forms": [{"word": "verbals", "tags": ["present", "singular", "third-person"]}, {"word": "verbaling", "tags": ["US", "participle", "present"]}, {"word": "verballing", "tags": ["UK", "participle", "present"]}, {"word": "verbaled", "tags": ["US", "participle", "past"]}, {"word": "verbaled", "tags": ["US", "past"]}, {"word": "verballed", "tags": ["UK", "participle", "past"]}, {"word": "verballed", "tags": ["UK", "past"]}], "senses": [{"definition": "(transitive, British, Australia) To allege (usually falsely) that someone has made an oral admission.", "tags": ["Australia", "British", "transitive"], "examples": [], "quotes": [{"text": "The problem of 'verballing' is unlikely to disappear, whatever the legal status of the person detained.", "reference": "1982, John A. Andrews, Human Rights in Criminal Procedure: A Comparative Study, BRILL, →ISBN, page 128:"}, {"text": "Condren had always claimed that he was assaulted and verballed by police over the murder he had supposedly confessed to committing. Specifically, Condren claimed that he had been subjected to assault and intimidation prior to making a police record of interview, that the record of interview was largely fabricated by police, and that the oral admissions which police claimed he had made prior to the record of interview were also fabricated.", "reference": "2001, Chris Cunneen, Conflict, Politics and Crime: Aboriginal Communities and the Police, Allen & Unwin, →ISBN, page 116:"}, {"text": "\"Moreover, given the risk of verballing, it is by no means apparent that it is in the interests of justice that the prosecution have the benefit of admissions that are made on occasions when recordings are impracticable.\"", "reference": "2004, Jeremy Gans, Andrew Palmer, Australian Principles of Evidence, Routledge Cavendish, →ISBN, page 504:"}, {"text": "Kelvin Condren maintained his innocence, claiming that he was 'verballed' in his police record of interview (so they were someone else's words not his).", "reference": "2019, Kate Burridge, Tonya N. Stebbins, For the love of language: An Introduction to Linguistics, page 305:"}, {"text": "As the necessary ingredient of an intention to commit an offence usually came from the mouth of the suspect himself, it was not difficult to make an arrest if the suspect was 'verballed'. A 'verbal' consisted of an unequivocal oral admission of guilt made to a police officer on the street, which, later on, the police officer transcribed into his notebook. It is called a 'verbal' if the suspect later denies making the incriminating remark.", "reference": "2020, Inigo Bing, Populism on Trial: What Happens When Trust in Law Breaks Down:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}], "source": {"url": "https://en.wiktionary.org/wiki/verbal", "license": {"name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"}}}}