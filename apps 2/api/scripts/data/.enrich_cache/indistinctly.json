{"word": "indistinctly", "source": "freedictionaryapi", "data": {"word": "indistinctly", "entries": [{"language": {"code": "en", "name": "English"}, "partOfSpeech": "adverb", "pronunciations": [], "forms": [{"word": "more indistinctly", "tags": ["comparative"]}, {"word": "most indistinctly", "tags": ["superlative"]}], "senses": [{"definition": "In an indistinct manner.", "tags": [], "examples": [], "quotes": [{"text": "Metanotum shining, indistinctly punctured at the base in the centre, the sides closely punctured; the areola large, obliquely narrowed at the base, its apex open, there are 2 lateral areas, both widely open at the base on the outerside; the posterior median area bears about 10 stout, transverse keels; on its apical outerside is a triangular area; the spiracular is bounded on the outerside by a distinct keel .", "reference": "1906, Records of the Albany Museum - Volume 1, page 314:"}], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "ca", "name": "Catalan"}, "word": "indistintament"}, {"language": {"code": "fr", "name": "French"}, "word": "indistinctement"}, {"language": {"code": "gl", "name": "Galician"}, "word": "indistintamente"}, {"language": {"code": "grc", "name": "Ancient Greek"}, "word": "ἀσαφῶς"}, {"language": {"code": "it", "name": "Italian"}, "word": "indistintamente"}, {"language": {"code": "pt", "name": "Portuguese"}, "word": "indistintamente"}, {"language": {"code": "es", "name": "Spanish"}, "word": "indistintamente"}], "subsenses": []}], "synonyms": [], "antonyms": ["distinctly"]}], "source": {"url": "https://en.wiktionary.org/wiki/indistinctly", "license": {"name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"}}}}