": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "verb", "pronunciations": [{"type": "ipa", "text": "/ˈmɛdəl/", "tags": []}, {"type": "ipa", "text": "[ˈmɛd.ɫ̩]", "tags": ["UK"]}, {"type": "ipa", "text": "[ˈmɛɾ.ɫ̩]", "tags": ["US"]}, {"type": "ipa", "text": "[ˈmeɾ.ɫ̩]", "tags": ["General Australian"]}], "forms": [{"word": "medals", "tags": ["present", "singular", "third-person"]}, {"word": "medaling", "tags": ["US", "participle", "present"]}, {"word": "medalling", "tags": ["UK", "participle", "present"]}, {"word": "medaled", "tags": ["US", "participle", "past"]}, {"word": "medaled", "tags": ["US", "past"]}, {"word": "medalled", "tags": ["UK", "participle", "past"]}, {"word": "medalled", "tags": ["UK", "past"]}], "senses": [{"definition": "(intransitive, sports, colloquial) To win a medal.", "tags": ["colloquial", "intransitive"], "examples": ["He medalled twice at the Olympics."], "quotes": [{"text": "I dashed into the mall; bought a gift; raced to the card store, snapped up a two-fer gift-bag special and was back in my car in 26 minutes. I could medal in power shopping.", "reference": "2004 October 29, Carol McAlice Currie, “Unposted laws make downtown seem unwelcoming”, in Statesman Journal, volume 152, number 214, Salem, OR, page 1C:"}, {"text": "Vocab-wise, medalling and PB-ing are now totally part-and-parcelled, and most experts in South Korea believe podiumed, finalled and all-comered are not far off lexiconing.", "reference": "2011 January 9, Harry Pearson, “London 2012 can legacy by verbing the noun”, in The Guardian:"}, {"text": "I wanted to medal. I was pregnant and I wanted to medal.", "reference": "2013 January 13, “Je Ne Sais What?”, in The Good Wife, season 4, episode 12, spoken by Anna (Elizabeth Alderfer):"}, {"text": "In 2008, after being passed over yet again for USA Basketball’s Beijing Olympics team, San Antonio Stars all-star Becky Hammon signed a four-year, $2m contract with CSKA Moscow that included a six-figure bonus for becoming a naturalised citizen and medaling at the Games.", "reference": "2022 September 3, Andrew Lawrence, “Brittney Griner’s Russian ordeal is a byproduct of WNBA’s shoestring funding”, in The Guardian:"}, {"text": "Rebecca Romero medaled in rowing and track cycling in 2004 and 2008, joining East German swimmer-turned-handball player Roswitha Krause and several swimmers/divers as two-sport medalists.", "reference": "2024 July 30, Beau Dure, “What’s tougher than competing in an Olympic sport? Competing in two”, in The Guardian:"}, {"text": "Though she never medalled at the Olympics, she did win a pair of golds at the Central American and Caribbean Games in San Salvador in 2002.", "reference": "2024 August 20, Edward Helmore, “Five-time Olympian cyclist found dead in Las Vegas after choking on food”, in The Guardian:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(transitive) To award a medal to.", "tags": ["transitive"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}], "source": {"url": "https://en.wiktionary.org/wiki/medal", "license": {"name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"}}}}