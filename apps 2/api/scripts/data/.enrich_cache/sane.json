{"word": "sane", "source": "freedictionaryapi", "data": {"word": "sane", "entries": [{"language": {"code": "en", "name": "English"}, "partOfSpeech": "adjective", "pronunciations": [{"type": "ipa", "text": "/seɪn/", "tags": []}], "forms": [{"word": "saner", "tags": ["comparative"]}, {"word": "sanest", "tags": ["superlative"]}], "senses": [{"definition": "Being in a healthy condition; not deranged; thinking rationally.", "tags": [], "examples": ["a sane mind"], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "Mentally sound; possessing a rational mind; having the mental faculties in such condition as to be able to anticipate and judge the effect of one's actions in an ordinary manner.", "tags": [], "examples": ["a sane person"], "quotes": [{"text": "Shepard: What's wrong with your assistant?\nDr. Warren: Manuel has a brilliant mind, but he's always been a bit... unstable. Genius and madness are two sides of the same coin.\nDr. Manuel: Is it madness to see the future? To see the destruction rushing towards us? To understand there is no escape? No hope? No, I am not mad. I'm the only sane one left!\nDr. Warren: I gave him an extra dose of his meds after the attack.", "reference": "2008, BioWare, Mass Effect (Science Fiction), Redwood City: Electronic Arts, →ISBN, →OCLC, PC, scene: Eden Prime:"}], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "bg", "name": "Bulgarian"}, "word": "здравомислещ"}, {"language": {"code": "cmn", "name": "Chinese Mandarin"}, "word": "神志正常"}, {"language": {"code": "cmn", "name": "Chinese Mandarin"}, "word": "頭腦清楚 /头脑清楚"}, {"language": {"code": "cmn", "name": "Chinese Mandarin"}, "word": "頭腦清晰 /头脑清晰"}, {"language": {"code": "cs", "name": "Czech"}, "word": "rozumný"}, {"language": {"code": "eo", "name": "Esperanto"}, "word": "prudenta"}, {"language": {"code": "eo", "name": "Esperanto"}, "word": "racia"}, {"language": {"code": "fi", "name": "Finnish"}, "word": "tervejärkine