ubsenses": [{"definition": "(informal) Ellipsis of pool noodle (“a long, slender tube or rod, extruded from buoyant foam and usually brightly coloured, used as an exercise tool or toy in swimming pools”).", "tags": ["abbreviation", "alt of", "broadly", "ellipsis", "informal"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}]}, {"definition": "(archaic) A dumpling cooked by boiling and served in soup; a knaidel or knödel.", "tags": ["archaic"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(slang) The penis.", "tags": ["slang"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(furry fandom) A long and slender dragon, usually an eastern dragon.", "tags": ["slang"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(Internet slang, endearing, humorous) A borzoi dog.", "tags": ["Internet", "endearing", "humorous"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": ["noodle"], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "noun", "pronunciations": [{"type": "ipa", "text": "[ˈnuː.dl̩]", "tags": ["Received Pronunciation"]}, {"type": "ipa", "text": "/ˈnu.dəl/", "tags": ["Canada", "General American", "Scotland"]}, {"type": "ipa", "text": "[ˈnuː.dl̩]", "tags": ["Canada", "General American", "Scotland"]}, {"type": "ipa", "text": "[ˈnʉː.dl̩]", "tags": ["General Australian"]}], "forms": [{"word": "noodles", "tags": ["plural"]}], "senses": [{"definition": "(dated) A person with poor judgment; a fool.", "tags": ["dated", "informal"], "examples": [], "quotes": [{"text": "Laura told me the names of all the actors and actreſſes as they preſented themſelves; and, not contented vvith this, the ſatyrical baggage deſcrib'd their characters nicely, as they appeared. \"This here (ſaid ſhe) is a noodle—That fellovv is a brute:[…].\"", "reference": "1751, [Alain-René Lesage], “Which is as Short as the Foregoing”, in [Tobias George Smollett], transl., The Adventures of Gil Blas of Santillane. […], 3rd edition, volume I, London: […] J. Osborn, […], →OCLC, book III, page 244:"}, {"text": "You vvrong me, noodle (boxes his ears). Novv then to the point.", "reference": "1796 March 25 (first performance), J[ames] C. Cross, “The Village Doctor, a Burletta. […]”, in Parnassian Bagatelles: Being a Miscellaneous Collection of Poetical Attempts. […], London: […] Burton and Co. […]; [for] Bellamy, […], published 1796, →OCLC, page 140:"}, {"text": "[T]hou would'st fling thy cuckoldy steeple-hat one way, and that bloodthirsty long-sword another, and trip like the noodles of Hogs-Norton, when the pigs play on the organ.", "reference": "1826, [Walter Scott], chapter III, in Woodstock; Or, The Cavalier. […], volume I, Edinburgh: […] [James Ballantyne and Co.] for Archibald Constable and Co.; London: Longman, Rees, Orme, Brown, and Green, →OCLC, page 67:"}, {"text": "[A] long and hopeless career in your profession, the chuckling grin of noodles, the sarcastic leer of the genuine political rogue— […] these were the penalties exacted for liberality of opinion at that period; and not only was there no pay, but there were many stripes.", "reference": "1839, Sydney Smith, “Preface”, in The Works of the Rev. Sydney Smith. […], volume I, London: […] [A[ndrew] Spottiswoode] for Longman, Orme, Brown, Green, and Longmans, […], →OCLC, page viii:"}, {"text": "If that portrait could speak, sir,— […] it would testify, that a long period has elapsed since I first habitually addressed it as the picture of a Noodle. Nothing that a Noodle does, can awaken surprise or indignation; the proceedings of a Noodle can only inspire contempt.", "reference": "1854, Charles Dickens, “Final”, in Hard Times. For These Times, London: Bradbury & Evans, […], →OCLC, 3rd book (Garnering), page 349:"}, {"text": "\"What are you two noodleth laughing at?\" Norrie went on, with a touch of indignation. \"Ithn't the thenthe of thent in hith nothe?\"", "reference": "1905 February 4, Alfred Colbeck, “Netted: The Story of a Capture”, in The Boy’s Own Paper, volume XXVII, number 19 (number 1360 overall), London: “Boy’s Own Paper” Office, […], →OCLC, chapter V (A Surprising Capture), page 314, column 1:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(slang) The brain; the head.", "tags": ["informal", "slang"], "examples": [], "quotes": [{"text": "[W]hat appears to at first glance to be a thinking problem can be a problem with sight or hearing. […] There's nothing wrong with your noodle; it's your sensory equipment that needs a bit of help. Learn to compensate.", "reference": "2006, Mark Victor Hansen, Art Linkletter, “Mind or Are You ‘Sageing’ or Aging?”, in How to Make the Rest of Your Life the Best of Your Life, Nashville, Tenn.: Nelson Books, Thomas Nelson, →ISBN, page 172:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": ["noodle"], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "verb", "pronunciations": [{"type": "ipa", "text": "[ˈnuː.dl̩]", "tags": ["Received Pronunciation"]}, {"type": "ipa", "text": "/ˈnu.dəl/", "tags": ["Canada", "General American", "Scotland"]}, {"type": "ipa", "text": "[ˈnuː.dl̩]", "tags": ["Canada", "General American", "Scotland"]}, {"type": "ipa", "text": "[ˈnʉː.dl̩]", "tags": ["General Australian"]}], "forms": [{"word": "noodles", "tags": ["present", "singular", "third-person"]}, {"word": "noodling", "tags": ["participle", "present"]}, {"word": "noodled", "tags": ["participle", "past"]}, {"word": "noodled", "tags": ["past"]}], "senses": [{"definition": "(transitive, obsolete) To fool or trick (someone).", "tags": ["informal", "obsolete", "transitive"], "examples": [], "quotes": [], "synony