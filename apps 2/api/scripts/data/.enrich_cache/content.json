nglish"}, "partOfSpeech": "noun", "pronunciations": [{"type": "ipa", "text": "/kənˈtɛnt/", "tags": []}], "forms": [], "senses": [{"definition": "Satisfaction, contentment; pleasure.", "tags": ["uncountable"], "examples": ["They were in a state of sleepy content after supper."], "quotes": [{"text": "‘It is very difficult to […] learn to seek content, instead of happiness.’", "reference": "1788, Mary Wollstonecraft, Mary: A Fiction:"}, {"text": "‘I understand you—upon every other subject, but the only one, my content requires, you are ready to obey me.’", "reference": "1791, Elizabeth Inchbald, A Simple Story, Penguin, published 2009, page 287:"}, {"text": "Like an empress, I feel great content surrounded by the familiar sounds of laughter, bickering, rattling plates, clicking chopsticks, smacking lips, and noisy sipping of the longevity brew.", "reference": "2008, Mingmei Yip, Peach Blossom Pavilion:"}, {"text": "Such is the fullness of my heart's content.", "reference": "1591 (date written), William Shakespeare, “The Second Part of Henry the Sixt, […]”, in Mr. William Shakespeares Comedies, Histories, & Tragedies. […] (First Folio), London: […] Isaac Iaggard, and Ed[ward] Blount, published 1623, →OCLC, [Act I, scene i]:"}, {"text": "Kleph moved slowly from the door and sank upon the chaise longue with a little sigh of content.", "reference": "1946, C.L. Moore, Vintage Season:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(obsolete) Acquiescence without examination.", "tags": ["obsolete", "uncountable"], "examples": [], "quotes": [{"text": "The sense they humbly take upon content.", "reference": "1711 May, [Alexander Pope], An Essay on Criticism, London: […] W[illiam] Lewis […]; and sold by W[illiam] Taylor […], T[homas] Osborn[e] […], and J[ohn] Graves […], →OCLC:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "That which contents or satisfies; that which if attained would make one