imonade"}, {"language": {"code": "eo", "name": "Esperanto"}, "word": "limonado"}, {"language": {"code": "et", "name": "Estonian"}, "word": "limonaad"}, {"language": {"code": "et", "name": "Estonian"}, "word": "limps"}, {"language": {"code": "fi", "name": "Finnish"}, "word": "sitruunasooda"}, {"language": {"code": "fi", "name": "Finnish"}, "word": "limonadi"}, {"language": {"code": "fr", "name": "French"}, "word": "limonade"}, {"language": {"code": "ka", "name": "Georgian"}, "word": "ლიმონათი"}, {"language": {"code": "de", "name": "German"}, "word": "Brause"}, {"language": {"code": "de", "name": "German"}, "word": "Limonade"}, {"language": {"code": "de", "name": "German"}, "word": "Limo"}, {"language": {"code": "el", "name": "Greek"}, "word": "λεμονάδα"}, {"language": {"code": "el", "name": "Greek"}, "word": "γκαζόζα"}, {"language": {"code": "el", "name": "Greek"}, "word": "λεμονίτα"}, {"language": {"code": "ja", "name": "Japanese"}, "word": "サイダー"}, {"language": {"code": "ko", "name": "Korean"}, "word": "사이다"}, {"language": {"code": "mk", "name": "Macedonian"}, "word": "газо́за"}, {"language": {"code": "nb", "name": "Norwegian Bokmål"}, "word": "sitronbrus"}, {"language": {"code": "nn", "name": "Norwegian Nynorsk"}, "word": "sitronbrus"}, {"language": {"code": "pl", "name": "Polish"}, "word": "lemoniada"}, {"language": {"code": "pt", "name": "Portuguese"}, "word": "soda limonada"}, {"language": {"code": "ru", "name": "Russian"}, "word": "лимона́д"}, {"language": {"code": "ru", "name": "Russian"}, "word": "газиро́вка"}, {"language": {"code": "gd", "name": "Scottish Gaelic"}, "word": "deoch-liomaid"}, {"language": {"code": "es", "name": "Spanish"}, "word": "gaseosa de limón"}, {"language": {"code": "es", "name": "Spanish"}, "word": "limonada"}, {"language": {"code": "es", "name": "Spanish"}, "word": "soda limonada"}, {"language": {"code": "sv", "name": "Swedish"}, "word": "citronläsk"}, {"language": {"code": "sv", "name": "Swedish"}, "word": "citronsoda"}, {"language"