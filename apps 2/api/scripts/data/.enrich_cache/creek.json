ations": [], "subsenses": []}, {"definition": "(Australia, New Zealand, Canada, US) A stream of water, typically a stream of freshwater smaller than a river; in Australia, also used of river-sized bodies of water.", "tags": ["Australia", "Canada", "New Zealand", "US"], "examples": [], "quotes": [{"text": "We all feel it Looming, even when we're awake, out there ahead someplace, the way you come to feel a River or Creek ahead, before anything else,— sound, sky, vegetation,— may have announced it.", "reference": "1997, Thomas Pynchon, chapter 67, in Mason & Dixon, 1st US edition, New York: Henry Holt and Company, →ISBN, part Two: America, page 650:"}], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "sq", "name": "Albanian"}, "word": "rrjedhë"}, {"language": {"code": "hy", "name": "Armenian"}, "word": "գետակ"}, {"language": {"code": "ebk", "name": "Eastern Bontoc"}, "word": "kinnaw"}, {"language": {"code": "ebk", "name": "Eastern Bontoc"}, "word": "arog-og"}, {"language": {"code": "bg", "name": "Bulgarian"}, "word": "поток"}, {"language": {"code": "ca", "name": "Catalan"}, "word": "rierol"}, {"language": {"code": "ca", "name": "Catalan"}, "word": "riera"}, {"language": {"code": "cic", "name": "Chickasaw"}, "word": "abookoshi"}, {"language": {"code": "cmn", "name": "Chinese Mandarin"}, "word": "小溪"}, {"language": {"code": "cs", "name": "Czech"}, "word": "potok"}, {"language": {"code": "dif", "name": "Dieri"}, "word": "karirri"}, {"language": {"code": "gur", "name": "Farefare"}, "word": "kʋlga class 3/4"}, {"language": {"code": "fi", "name": "Finnish"}, "word": "puro"}, {"language": {"code": "fr", "name": "French"}, "word": "ruisseau"}, {"language": {"code": "gl", "name": "Galician"}, "word": "regato"}, {"language": {"code": "gl", "name": "Galician"}, "word": "bullón"}, {"language": {"code": "gl", "name": "Galician"}, "word": "barbaña"}, {"language": {"code": "gl", "name": "Galician"}, "word": "regueiro"}, {"language": {"code": "gl", "name": "Gali