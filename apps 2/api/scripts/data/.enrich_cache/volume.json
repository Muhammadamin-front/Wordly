": ["transitive"], "examples": [], "quotes": [{"text": "We lay leaning over the bows, now looking up at the mist blown in never-ending volumed sheets, now at the sail swelling in the wind before which it fled, and again down at the water through which our boat was ploughing its evanescent furrow.", "reference": "1872, George Macdonald, chapter 15, in Wilfrid Cumbermede, volume I, London: Hurst & Blackett, page 243:"}, {"text": "The censer, voluming upwards its ash-gray smoke, was now passed from hand to hand three times round the patient, and finally deposited on the floor at his feet.", "reference": "1900, Walter William Skeat, chapter 6, in Malay Magic, London: Macmillan, page 420:"}, {"text": "The record player on the first floor volumed up Lonnie Johnson singing, “Tomorrow night, will you remember what you said tonight?”", "reference": "1969, Maya Angelou, chapter 33, in I Know Why the Caged Bird Sings, New York: Bantam, published 1971, page 219:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(intransitive) To swell.", "tags": ["intransitive"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}], "source": {"url": "https://en.wiktionary.org/wiki/volume", "license": {"name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"}}}}