{"word": "clever", "source": "freedictionaryapi", "data": {"word": "clever", "entries": [{"language": {"code": "en", "name": "English"}, "partOfSpeech": "adjective", "pronunciations": [{"type": "ipa", "text": "/ˈklɛv.ə/", "tags": ["Received Pronunciation"]}, {"type": "ipa", "text": "/ˈklɛv.ɚ/", "tags": ["General American"]}], "forms": [{"word": "cleverer", "tags": ["comparative"]}, {"word": "more clever", "tags": ["comparative"]}, {"word": "cleverest", "tags": ["superlative"]}, {"word": "most clever", "tags": ["superlative"]}], "senses": [{"definition": "Nimble with hands or body; dexterous; skillful; adept.", "tags": [], "examples": ["My dad is quite clever with his hands, especially at carpentry.", "a. 1898, Francis James Child (collator), Child's Ballads, 198: \"Bonny John Seton\",\nThe Highland men, they're clever men\nAt handling sword and shield,"], "quotes": [], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "bg", "name": "Bulgarian"}, "word": "сръчен"}, {"language": {"code": "bg", "name": "Bulgarian"}, "word": "изкусен"}, {"language": {"code": "my", "name": "Burmese"}, "word": "တော်"}, {"language": {"code": "ca", "name": "Catalan"}, "word": "àgil"}, {"language": {"code": "ca", "name": "Catalan"}, "word": "hàbil"}, {"language": {"code": "ca", "name": "Catalan"}, "word": "destre"}, {"language": {"code": "da", "name": "Danish"}, "word": "kvik"}, {"language": {"code": "da", "name": "Danish"}, "word": "rask"}, {"language": {"code": "da", "name": "Danish"}, "word": "snild"}, {"language": {"code": "fi", "name": "Finnish"}, "word": "kätevä"}, {"language": {"code": "fr", "name": "French"}, "word": "habile"}, {"language": {"code": "fr", "name": "French"}, "word": "agile"}, {"language": {"code": "fr", "name": "French"}, "word": "adroit"}, {"language": {"code": "fr", "name": "French"}, "word": "adroite"}, {"language": {"code": "de", "name": "German"}, "word": "geschickt"}, {"language": {"code": "hu", "name": "Hungarian"}, "word": "ügyes"}, {"lang