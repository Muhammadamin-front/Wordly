gs": ["transitive"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(obsolete, chiefly passive voice) To cover newly-sown fields of crops with ashes.", "tags": ["obsolete"], "examples": ["Last spring, after I planted, I took what ashes I have saved during the last year, and put on my corn […] . On harvesting I cut up the two rows which were not ashed (or twenty rods of them,) and set them apart from the others in stouts; and then I cut up two rows of the same length, on each side, which had been ashed, […]", "After the corn was planted, upon acre A, I spread broadcast one hundred bushels of lime, (cost $3) and fifty bushels of ashes, (cost $6.) […] The extra crop of the combination over the limed acre or ashed, was paid by the increased crop, […]"], "quotes": [], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "fi", "name": "Finnish"}, "word": "tuhkata"}, {"language": {"code": "si", "name": "Sinhalese"}, "word": "නවදැලි හේන"}], "subsenses": []}], "synonyms": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "noun", "pronunciations": [{"type": "ipa", "text": "/ˈæʃ/", "tags": []}, {"type": "ipa", "text": "[ˈæʃ]", "tags": []}], "forms": [{"word": "ashes", "tags": ["plural"]}], "senses": [{"definition": "(countable, uncountable) A shade tree of the genus Fraxinus.", "tags": ["countable", "uncountable"], "examples": ["The ash trees are dying off due to emerald ash borer.", "The woods planted in ash will see a different mix of species."], "quotes": [], "synonyms": ["ash tree"], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(countable, uncountable) Any tree of certain species of other genera.", "tags": ["countable", "uncountable"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(uncountable) The wood of this tree.", "tags": ["uncountable"], "examples": [], 