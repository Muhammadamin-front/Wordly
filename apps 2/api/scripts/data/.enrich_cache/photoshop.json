{"word": "photoshop", "source": "freedictionaryapi", "data": {"word": "photoshop", "entries": [{"language": {"code": "en", "name": "English"}, "partOfSpeech": "verb", "pronunciations": [{"type": "ipa", "text": "/ˈfəʊ.təʊ.ʃɒp/", "tags": ["UK"]}, {"type": "ipa", "text": "/ˈfoʊ.toʊ.ʃɑp/", "tags": ["US"]}], "forms": [{"word": "photoshops", "tags": ["present", "singular", "third-person"]}, {"word": "photoshopping", "tags": ["participle", "present"]}, {"word": "photoshopped", "tags": ["participle", "past"]}, {"word": "photoshopped", "tags": ["past"]}, {"word": "Photoshop", "tags": ["alternative"]}], "senses": [{"definition": "(trademark, media, computing, usually transitive) To digitally edit or alter (a picture or photograph).", "tags": ["transitive", "usually"], "examples": ["She charged that the prosecutor had photoshopped the image to incriminate her."], "quotes": [{"text": "Photographs can be manipulated, too; while a \"Photoshopped\" image may look beautiful, it might not give a correct impression of a place (this is a whole other column).", "reference": "1995 September 24, “Some surf the Net, others quiver on the shore”, in The Record, Hackensack, New Jersey, page 167:"}, {"text": "Ned Shaw, a former illustrator for PC Magazine, has gathered a huge collection of classic examples from such artists and illustrators as Maxfield Parish and Edmund Dulac. He then Photoshopped it (a new verb; you heard it first here) and produced two volumes of fantastic art. The cool part is that the product comes in two resolutions.", "reference": "1997 May 6, PC Magazine, New York: Ziff Davis, page 89:"}, {"text": "The feisty brunette star of The Mummy [sc. Rachel Weisz] boasts: \"I really did hold that snake. People thought it was Photoshopped in, but it was the real thing. I had to stay relaxed.\" What about the snake?", "reference": "2004 May 20, “PS...”, in The Times (People section), number 68080, London: News UK, →ISSN, →OCLC, page 6:"}], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "yue", "name": "Chinese Cantonese"}, "word": "執相 /执相"}, {"language": {"code": "cmn", "name": "Chinese Mandarin"}, "word": "PS (pi'aisi)"}, {"language": {"code": "cmn", "name": "Chinese Mandarin"}, "word": "P (pī)"}, {"language": {"code": "cmn", "name": "Chinese Mandarin"}, "word": "P圖 /P图"}, {"language": {"code": "cmn", "name": "Chinese Mandarin"}, "word": "修圖 /修图"}, {"language": {"code": "cmn", "name": "Chinese Mandarin"}, "word": "美圖 /美图"}, {"language": {"code": "da", "name": "Danish"}, "word": "fotomanipulere"}, {"language": {"code": "da", "name": "Danish"}, "word": "photoshoppe"}, {"language": {"code": "nl", "name": "Dutch"}, "word": "fotoshoppen"}, {"language": {"code": "fi", "name": "Finnish"}, "word": "photoshopata"}, {"language": {"code": "fr", "name": "French"}, "word": "photoshoper"}, {"language": {"code": "de", "name": "German"}, "word": "photoshoppen"}, {"language": {"code": "hu", "name": "Hungarian"}, "word": "photoshoppol"}, {"language": {"code": "ja", "name": "Japanese"}, "word": "フォトショする"}, {"language": {"code": "mr", "name": "Marathi"}, "word": "फोटोशॉप करणे"}, {"language": {"code": "pl", "name": "Polish"}, "word": "fotoszopować"}, {"language": {"code": "pl", "name": "Polish"}, "word": "sfotoszopować"}, {"language": {"code": "pt", "name": "Portuguese"}, "word": "photoshopar"}, {"language": {"code": "ru", "name": "Russian"}, "word": "фотошопить"}, {"language": {"code": "es", "name": "Spanish"}, "word": "photoshopear"}, {"language": {"code": "es", "name": "Spanish"}, "word": "fotoshopear"}, {"language": {"code": "sv", "name": "Swedish"}, "word": "photoshoppa"}, {"language": {"code": "th", "name": "Thai"}, "word": "โฟโตชอป"}], "subsenses": []}], "synonyms": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "noun", "pronunciations": [{"type": "ipa", "text": "/ˈfəʊ.təʊ.ʃɒp/", "tags": ["UK"]}, {"type": "ipa", "text": "/ˈfoʊ.toʊ.ʃɑp/", "tags": ["US"]}], "forms": [{"word": "photoshops", "tags"