rie] Belloc Lowndes, chapter II, in The Lodger, London: Methuen, →OCLC; republished in Novels of Mystery: The Lodger; The Story of Ivy; What Really Happened, New York, N.Y.: Longmans, Green and Co., […], [1933], →OCLC, page 0091:"}, {"text": "Many genes with reproductive roles also have antibacterial and immune functions, which indicate that the threat of microbial attack on the sperm or egg may be a major influence on rapid evolution during reproduction.", "reference": "2013 May-June, Katrina G. Claw, “Rapid Evolution in Eggs and Sperm”, in American Scientist, volume 101, number 3:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": [{"definition": "(chiefly archaic) Used of people (now generally who, whom, that; which remains possible with words also referred to by it such as baby, child).", "tags": ["archaic", "relative"], "examples": ["She had a young child, which cried incessantly."], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}]}, {"definition": "Referring to a preceding statement.", "tags": ["relative"], "examples": ["The front door was open, which concerned me.", "He had to leave, which was very difficult.", "She saved my life, for which I am eternally grateful."], "quotes": [{"text": "Plastics are energy-rich substances, which is why many of them burn so readily. Any organism that could unlock and use that energy would do well in the Anthropocene. Terrestrial bacteria and fungi which can manage this trick are already familiar to experts in the field.", "reference": "2013 July 20, “Welcome to the plastisphere”, in The Economist, volume 408, number 8845:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}]}, {"definition": "(relative, sometimes proscribed, see usage notes) In a restrictive relative clause, referring to a noun previously mentioned.", "tags": ["proscribed", "relative", "sometimes"], "examples": ["This is the letter which I received.", "This is the letter in which he explains his decision."], "quotes": [{"text": "Forasmuch as many have taken in hand to set forth in order a declaration of those things which are most surely believed among us...", "reference": "1611, The Holy Bible, […] (King James Version), London: […] Robert Barker, […], →OCLC, Luke 1:1:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": [{"definition": "(chiefly archaic) Used of people.", "tags": ["archaic", "proscribed", "relative", "sometimes"], "examples": [], "quotes": [{"text": "The men which acompanyed him on his waye stode amased, for they herde a voyce, butt sawe no man.", "reference": "1526, [William Tyndale, transl.], The Newe Testamẽt […] (Tyndale Bible), [Worms, Germany: Peter Schöffer], →OCLC, Acts:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}]}], "synonyms": [], "antonyms": []}], "source": {"url": "https://en.wiktionary.org/wiki/which", "license": {"name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"}}}}