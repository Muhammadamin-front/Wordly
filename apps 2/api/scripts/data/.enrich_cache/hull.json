a"}, {"language": {"code": "sv", "name": "Swedish"}, "word": "skrov"}, {"language": {"code": "ota", "name": "Ottoman Turkish"}, "word": "تكنه"}, {"language": {"code": "ota", "name": "Ottoman Turkish"}, "word": "قارن"}, {"language": {"code": "uk", "name": "Ukrainian"}, "word": "ко́рпус"}, {"language": {"code": "cy", "name": "Welsh"}, "word": "corff llong"}], "subsenses": []}, {"definition": "(mathematics, geometry, of a set A) The smallest set that possesses a particular property (such as convexity) and contains every point of A; slightly more formally, the intersection of all sets which possess the specified property and of which A is a subset.", "tags": [], "examples": ["The orthogonal convex hull of an orthogonal polygon is the smallest orthogonally convex polygon that encloses the original polygon.", "holomorphically convex hull; affine hull; injective hull"], "quotes": [], "synonyms": ["span"], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "verb", "pronunciations": [{"type": "ipa", "text": "/hʌl/", "tags": []}, {"type": "ipa", "text": "/hʊl/", "tags": ["Northern England"]}], "forms": [{"word": "hulls", "tags": ["present", "singular", "third-person"]}, {"word": "hulling", "tags": ["participle", "present"]}, {"word": "hulled", "tags": ["participle", "past"]}, {"word": "hulled", "tags": ["past"]}], "senses": [{"definition": "(obsolete, intransitive, nautical) To drift; to be carried by the impetus of wind or water on the ship's hull alone, with sails furled.", "tags": ["intransitive", "obsolete"], "examples": [], "quotes": [{"text": "We goe not, but we are carried: as things that flote, now gliding gently, now hulling violently, according as the water is, either stormy or calme.", "reference": "1603, Michel de Montaigne, chapter 1, in John Florio, transl., The Essayes […], book II, London: […] Val[entine] Simmes for Edward Blount […], →OCLC:"}, {"text": "[…] Th