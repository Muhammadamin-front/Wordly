s": [{"text": "And bonds without a date, they say, are void.", "reference": "1681, John Dryden, The Spanish Fryar: Or, the Double Discovery. […], London: […] Richard Tonson and Jacob Tonson, […], →OCLC, (please specify the page number):"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "A specific day in time at which a transaction or event takes place, or is appointed to take place; a given point of time.", "tags": [], "examples": ["the date for pleading", "The start date for the festival is September 2.", "Do you know the date of the wedding?", "We had to change the dates of the festival because of the flooding."], "quotes": [{"text": "He at once, Down the long series of eventful time, So fix'd the dates of being, so disposed To every living soul of every kind The field of motion, and the hour of rest.", "reference": "1844, Mark Akenside, The Pleasures of the Imagination, Book II:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "A point in time.", "tags": [], "examples": ["You may need that at a later date."], "quotes": [], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "hy", "name": "Armenian"}, "word": "պահ"}, {"language": {"code": "bg", "name": "Bulgarian"}, "word": "вре́ме"}, {"language": {"code": "cs", "name": "Czech"}, "word": "doba"}, {"language": {"code": "da", "name": "Danish"}, "word": "tidspunkt"}, {"language": {"code": "nl", "name": "Dutch"}, "word": "tijdstip"}, {"language": {"code": "eo", "name": "Esperanto"}, "word": "tempo"}, {"language": {"code": "eo", "name": "Esperanto"}, "word": "dato"}, {"language": {"code": "et", "name": "Estonian"}, "word": "hetk"}, {"language": {"code": "fi", "name": "Finnish"}, "word": "ajankohta"}, {"language": {"code": "de", "name": "German"}, "word": "Zeitpunkt"}, {"language": {"code": "hu", "name": "Hungarian"}, "word": "időpont"}, {"language": {"code": "it", "name": "Italian"}, "word": "data"}, {"language": {"code": "kmr", "name": "Northern Kurdish"}, "word": "dem"}, {"language": {"code": "lv", "name": "Latvian"}, "word": "laiks"}, {"language": {"code": "nb", "name": "Norwegian Bokmål"}, "word": "dato"}, {"language": {"code": "nn", "name": "Norwegian Nynorsk"}, "word": "dato"}, {"language": {"code": "pl", "name": "Polish"}, "word": "data"}, {"language": {"code": "pt", "name": "Portuguese"}, "word": "data"}, {"language": {"code": "ru", "name": "Russian"}, "word": "вре́мя"}, {"language": {"code": "gd", "name": "Scottish Gaelic"}, "word": "ceann-latha"}, {"language": {"code": "es", "name": "Spanish"}, "word": "fecha"}, {"language": {"code": "sv", "name": "Swedish"}, "word": "tidpunkt"}, {"language": {"code": "tl", "name": "Tagalog"}, "word": "taburaw"}, {"language": {"code": "tl", "name": "Tagalog"}, "word": "petsa"}], "subsenses": []}, {"definition": "(rare) An assigned end; a conclusion.", "tags": ["rare"], "examples": [], "quotes": [{"text": "But because he is but briefe, and these things of great consequence not to be kept obscure, I shall conceave it nothing above my duty either for the difficulty or the censure that may passe thereon, to communicate such thoughts as I also have had, and do offer them now in this generall labour of reformation, to the candid view both of Church and Magistrate; especially because I see it the hope of good men, that those irregular and unspirituall Courts have spun their utmost date in this Land; and some beter course must now be constituted.", "reference": "1643, John Milton, Doctrine and Discipline of Divorce:"}, {"text": "What Time would spare, from Steel receives its date.", "reference": "1714, Alexander Pope, “The Rape of the Lock”, in The Works of Mr. Alexander Pope, volume I, London: […] W[illiam] Bowyer, for Bernard Lintot, […], published 1717, →OCLC:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(obsolete) A given or assigned length of life; duration.", "tags": ["obsolete"], "examples": ["1611-15, George Chapman (translator), Homer (author), The Odysseys of Homer, Volume 1, Book IV, lines 282–5,\nAs now Saturnius, through his life's whole date,\nHath Nestor's bliss raised to as steep a state,\nBoth in his age to keep in peace his house,\nAnd to have children wise and valorous."], "quotes": [{"text": "Good luck prolonged hath thy date.", "reference": "1590, Edmund Spenser, “Book I, Canto IX”, in The Faerie Queene. […], London: […] [John Wolfe] for William Ponsonbie, →OCLC, stanza 45:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "A pre-arranged meeting.", "tags": [], "examples": ["I arranged a date with my Australian business partners."], "quotes": [{"text": "\"Why, Mr. Nisbet! I thought you were in New York.\"\n\"I had a telegram this morning, calling the date off,\"", "reference": "1903, Guy Wetmore Carryl, The Lieutenant-Governor, Houghton, Mifflin and Company, page 121:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "One's companion for social activities or occasions, especially a romantic partner.", "tags": [], "examples": ["I brought Melinda to the wedding as my date."], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "A romantic meeting or outing with a lover or potential lover, or the person so met.", "tags": [], "examples": ["We really hit it off on the first date, so we decided to meet the week after.", "The cinema is a popular place to take someone on a date."], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "verb", "pronunciations": [{"type": "ipa", "text": "/deɪt/", "tags": []}], "forms": [{"word": "dates", "tags": ["present", "singular", "third-person"]}, {"word": "dating", "tags": ["participle", "present"]}, {"word": "dated", "tags": ["participle", "past"]}, {"word": "dated", "tags": ["past"]}], "senses": [{"definition": "(transitive) To note the time or place of writing or executing; to express in an instrument the time of its execution.", "tags": ["transitive"], "examples": ["to date a letter, a bond, a deed, or a charter"], "quotes": [{"text": "You will be surprised, I don't question, to find among your correspondencies in foreign parts, a letter dated from Blois.", "reference": "1699, Joseph Addison, Letter to Rt. Hon. Charles Montagu, Esq., Blois, France; republished in Lucy Aikin, chapter 3, in The Life of Joseph Addison, volume 1, Longman, Brown, Green, and Longmans, 1843, page 79:"}, {"text": "I keep to the very words of the letter; but that, by \"this State,\" is meant the State of Pennsylvania, cannot be doubted, especially when we see that the letter is dated at Philadelphia.", "reference": "1796 January 1, William Cobbett, A New Year's Gift to the Democrats, footnote; republished in Porcupine's Works, volume 2, London: For Cobbett and Morgan, 1801, page 430:"}, {"text": "In these countries much of his Journal seems to have been written; parts of it are dated from them; and there, a few weeks before his fifty-ninth birthday, he fell sick and died.", "reference": "1865, Matthew Arnold, “Marcus Aurelius”, in Essays in Criticism, London: Macmillan and Co. […], →OCLC, page 281:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(transitive) To note or fix the time of (an event); to give the date of.", "tags": ["transitive"], "examples": [], "quotes": [{"text": "The writer dates the festival on June 21st, which is probably a mistake.", "reference": "1911, James George Frazer, The Golden Bough, volume 10, page 202:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(transitive) To determine the age of something.", "tags": ["transitive"], "examples": ["to date the building of the pyramids"], "quotes": [], "synonyms": [], "antonyms": [], "translations": 