", "alive", "animate", "animated", "brisk", "busy", "busy as a bee", "buxom", "buzzing", "diligent", "driven", "driving", "dynamic", "eager", "effervescent", "energetic", "enthusiastic", "expeditious", "frisky", "gay", "genki", "glowing", "happy", "hearty", "impetuous", "industrious", "keen", "kinetic", "lively", "merry", "mobile", "motivated", "moving", "nimble", "peppy", "perky", "restive", "sassy", "snappy", "spirited", "sprightly", "sprunt", "spry", "vibrant", "vigorous", "vivacious", "vivid", "wanton", "youthful", "zealous", "zestful", "zippy"], "antonyms": ["enervated", "extinct", "haggard", "inactive", "lither", "nondriven", "quiet", "restful", "sleeping", "slow"]}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "noun", "pronunciations": [{"type": "ipa", "text": "/ˈæk.tɪv/", "tags": []}], "forms": [{"word": "actives", "tags": ["plural"]}], "senses": [{"definition": "A person or thing that is acting or capable of acting.", "tags": [], "examples": [], "quotes": [{"text": "\"Alumni could become more active in giving guidance and leadership to students. They act as sort of a 'maturity governor' on fraternities,\" notes Ratliff, citing surveys suggesting that fraternity actives presume mistakenly that alumni want hazing […]", "reference": "1989, The Alcalde, volume 78, number 2, page 11:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(electronics) Any component that is not passive. See Passivity (engineering).", "tags": [], "examples": [], "quotes": [{"text": "Components are split into two broad segments: actives and passives. Active components like the vacuum tube and the transistor contain the power to generate and alter electrical signals.", "reference": "2013, David Manners, Hitchhikers' Guide to Electronics in the '90s, page 36:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}], "source": {"url": "https://en.wiktionary.org/wiki/active", "licen