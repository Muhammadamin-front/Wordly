"ages", "tags": ["present", "singular", "third-person"]}, {"word": "aging", "tags": ["participle", "present"]}, {"word": "ageing", "tags": ["participle", "present"]}, {"word": "aged", "tags": ["participle", "past"]}, {"word": "aged", "tags": ["past"]}], "senses": [{"definition": "(intransitive) To grow aged; to become old or older; to show marks of age.", "tags": ["intransitive"], "examples": ["He grew fat as he aged."], "quotes": [{"text": "I am aging; that is, I have a whitish, or rather a light-coloured, hair here and there. Sober thinking brings them", "reference": "1824, Walter Savage Landor, Imaginary Conversations:"}, {"text": "However, if you have the misfortune of being a child actor born on the show, watch out. […] The point is these kids age quickly.", "reference": "1998, Joe Malarkey, “Soap Operas”, in It’s Not the Fall That Kills You: Laughing All the Way to That Sudden Stop at the End, Latent Print, →ISBN, pages 123–124:"}, {"text": "As we age, the major arteries of our bodies frequently become thickened with plaque, a fatty material with an oatmeal-like consistency that builds up along the inner lining of blood vessels. The reason plaque forms isn’t entirely known, but it seems to be related to high levels of cholesterol inducing an inflammatory response, which can also attract and trap more cellular debris over time.", "reference": "2013 July–August, Stephen P. Lownie, David M. Pelz, “Stents to Prevent Stroke”, in American Scientist:"}, {"text": "“Most of the scribes here came after the Rending. Many of them stopped casting the spells that prolong their life, so they are aging. More slowly than humans, but still aging.” / “How old are you?” / “Biologically?” He smiled. “Around thirty. But I’ve lived for over four hundred years.”", "reference": "2013 October 12, Elizabeth Hunter, chapter 9, in The Scribe (Irin Chronicles; 1), Recurve Press, →ISBN:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": [{"definition": "(intransitive, of a statement, prediction, etc.) To suffer the passage of time so as to later be viewed or turn out in a certain way.", "tags": ["intransitive", "usually"], "examples": ["His prediction that we didn't stand a chance hasn't aged well, now that we've won the cup.", "The sitcom was made in the 1970s and its casual sexism has not aged well."], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}]}, {"definition": "(transitive) To cause to grow old; to impart the characteristics of age to.", "tags": ["transitive"], "examples": ["Grief ages us."], "quotes": [{"text": "To look at the hair by itself you'd say it was actually quite pretty, but on her head the gray sure ages her.", "reference": "1998 Fall, Mare Freed, “Aluhana”, in The Antioch Review, volume 56, number 4:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": [{"definition": "To allow to mature.", "tags": ["transitive"], "examples": ["We age the whiskey for five years."], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "To treat or tamper with in order to give a false appearance of age.", "tags": ["transitive"], "examples": ["This clock is modern, but it has been deliberately aged in an attempt to make it seem antique."], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}]}, {"definition": "(transitive) To determine the age of (the length of time that something has been alive or in existence).", "tags": ["transitive"], "examples": ["There are several ways to age trees."], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(transitive) To indicate or reveal that (a person) has been alive for a certain period of time, especially a long one.", "tags": ["transitive"], "examples": ["I clearly remember hearing the news of Kennedy's assassination. That ages me."], "quotes": [{"text": "Mr. [David] Brinkley started out with network news. We got our news- I think it was the Huntley-Brinkley Report. I'm probably aging myself now, okay?", "reference": "1992 June 14, This Week with David Brinkley (television production), spoken by [James?] Carville, via ABC:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(transitive, figuratively) To allow (something) to persist by postponing an action that would extinguish it, as a debt.", "tags": ["figuratively", "transitive"], "examples": ["Money's a little tight right now. Let's age our bills for a week or so."], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(transitive, accounting) To categorize by age.", "tags": ["transitive"], "examples": ["One his first assignments was to age the accounts receivable."], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": ["mature", "elden", "age", "eld", "date", "get on", "grow up", "obsolesce", "olden", "season", "senesce", "superannuate", "upgrow"], "antonyms": ["rejuvenate", "youngen", "youthen"]}], "source": {"url": "https://en.wiktionary.org/wiki/age", "license": {"name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"}}}}