{"word": "ignorant", "source": "freedictionaryapi", "data": {"word": "ignorant", "entries": [{"language": {"code": "en", "name": "English"}, "partOfSpeech": "adjective", "pronunciations": [{"type": "ipa", "text": "/ˈɪɡ.nə.ɹənt/", "tags": []}, {"type": "ipa", "text": "/ˈɪɡ.nənt/", "tags": []}], "forms": [{"word": "ignoranter", "tags": ["comparative"]}, {"word": "more ignorant", "tags": ["comparative"]}, {"word": "ignorantest", "tags": ["superlative"]}, {"word": "most ignorant", "tags": ["superlative"]}, {"word": "ignoraunt", "tags": ["alternative", "obsolete"]}, {"word": "ignant", "tags": ["alternative"]}], "senses": [{"definition": "Unknowledgeable or uneducated; characterized by ignorance.", "tags": [], "examples": [], "quotes": [{"text": "That man that doth not know those things which are of use and necessity for him to know, is but an ignorant man, whatever he may know besides;", "reference": "1664, John Tillotson, “Sermon I. The Wisdom of Being Religious. Job XXVIII. 28.”, in The Works of the Most Reverend Dr. John Tillotson, Late Lord Archbishop of Canterbury: […], London: […] B. Aylmer, […]; [a]nd W. Rogers, […], published 1696, →OCLC:"}, {"text": "The ignorant peasant, without fault, is greater than the philosopher with many; for what is genius or courage without an heart?", "reference": "1766, Oliver Goldsmith, chapter 15, in The Vicar of Wakefield, volume I, London: F. Newbery, page 150:"}], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "sq", "name": "Albanian"}, "word": "injorant"}, {"language": {"code": "ar", "name": "Arabic"}, "word": "جَاهِل"}, {"language": {"code": "arz", "name": "Arabic"}, "word": "جاهل"}, {"language": {"code": "acw", "name": "Arabic"}, "word": "جاهل"}, {"language": {"code": "hy", "name": "Armenian"}, "word": "տգետ"}, {"language": {"code": "hy", "name": "Armenian"}, "word": "անգրագետ"}, {"language": {"code": "ast", "name": "Asturian"}, "word": "inorante"}, {"language": {"code": "az", "name": "Azerbaijani"}, "w