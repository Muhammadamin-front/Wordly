ations": [], "subsenses": []}, {"definition": "(archaic, intransitive) To be peevish; to sulk.", "tags": ["archaic", "intransitive"], "examples": [], "quotes": [{"text": "He sure is queasie stomach't that must pet, and puke, at such a trivial circumstance", "reference": "1623, Owen Feltham, Resolves: Divine, Moral, Political:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": ["pat", "smooth", "feel up", "grope", "touch up", "coddle", "cosset", "mope", "pout"], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "adjective", "pronunciations": [{"type": "ipa", "text": "/pɛt/", "tags": []}, {"type": "ipa", "text": "[pʰɛt]", "tags": []}, {"type": "ipa", "text": "[pʰɛʔ]", "tags": []}, {"type": "ipa", "text": "[pʰɛʔt]", "tags": []}], "forms": [], "senses": [{"definition": "(figurative) Favourite; cherished; the focus of one's (usually positive) attention.", "tags": ["figuratively", "not comparable"], "examples": ["a pet project", "a pet child", "The professor seemed offended by the criticism of her pet theory."], "quotes": [{"text": "Some young lady's pet curate.", "reference": "1886, Frederic Harrison, The Choice of Books:"}, {"text": "Major Butler has a pet grievance and a pet aversion, which he forces on the reader in every chapter, and which becomes at last very wearisome.", "reference": "1875, William Conant Church, The Galaxy, page 141:"}, {"text": "In an interview with Flying magazine, Heberding commented that her pet annoyance was \"the reluctance of people generally to accept a woman whether as a pilot or a preflight inspector.\"", "reference": "1991, Deborah G. Douglas, United States Women in Aviation, 1940-1985, page 9:"}, {"text": "Discussing a favourite book, JW Dunne's An Experiment with Time—a 1927 study by an English aeronautical engineer who developed his own pet theories about dreams, perception and reality—he [Gaspar Noé] sounds like an earnest young philosophy student.", "reference": "2002 August 2, Geoffrey Macnab, “'The rape had to be disgusting to be useful'”, in The Guardian, →ISSN:"}, {"text": "But these digital currencies[…] have now become a pet project of the US administration and a hot topic in corporate boardrooms.", "reference": "2025 July 5, Philip Stafford, Akila Quinio, “Stablecoins begin to enter the mainstream with backing from Trump administration”, in FT Weekend, London: The Financial Times Ltd., →ISSN, →OCLC, page 11:"}], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "bg", "name": "Bulgarian"}, "word": "любим"}, {"language": {"code": "fr", "name": "French"}, "word": "fétiche"}, {"language": {"code": "hu", "name": "Hungarian"}, "word": "imádott"}, {"language": {"code": "hu", "name": "Hungarian"}, "word": "szeretett"}, {"language": {"code": "es", "name": "Spanish"}, "word": "personal"}, {"language": {"code": "es", "name": "Spanish"}, "word": "favorido (disused)"}], "subsenses": []}, {"definition": "(literally) Kept or treated as a pet.", "tags": ["literally", "not comparable"], "examples": ["pet rock"], "quotes": [], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "bg", "name": "Bulgarian"}, "word": "домашен"}, {"language": {"code": "fr", "name": "French"}, "word": "de compagnie"}, {"language": {"code": "hu", "name": "Hungarian"}, "word": "házi-"}, {"language": {"code": "pt", "name": "Portuguese"}, "word": "de estimação"}, {"language": {"code": "cy", "name": "Welsh"}, "word": "anwes"}], "subsenses": []}, {"definition": "(obsolete) Good; ideal.", "tags": ["not comparable", "obsolete"], "examples": [], "quotes": [{"text": "“Now,” said Hands, “look there; there’s a pet bit for to beach a ship in. Fine flat sand, never a cat's paw, trees all around of it, and flowers a-blowing like a garding on that old ship.”", "reference": "1881–1882, Robert Louis Stevenson, Treasure Island, London; Paris: Cassell & Company, published 14 November 1883, →OCLC:"}], "synonyms": [], "antonyms": [], "transla