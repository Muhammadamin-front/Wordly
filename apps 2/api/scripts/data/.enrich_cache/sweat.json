ranslations": [], "subsenses": []}, {"definition": "(intransitive) To suffer a penalty; to smart for one's misdeeds.", "tags": ["intransitive"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(transitive) To take a racehorse for a short exercise run.", "tags": ["transitive"], "examples": [], "quotes": [{"text": "A Horſe that gains Fleſh in hard Exerciſe, should be ſweated at leaſt twice in ten Days; and he ſhould run near five Miles in Puſhes, that the Sweat may have Time to diſcharge. Those Horſes which are ſweat without Covering, or with a very thin one, should run a long Sweat, as wel call it, and ſtand a conſiderable while afterwards with a thick Blanket or two over them, from Head to Tail; otherwiſe the Sweat will not come out well.", "reference": "1740, Henry Bracken, Farriery improv'd:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}], "source": {"url": "https://en.wiktionary.org/wiki/sweat", "license": {"name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"}}}}