 "leaks", "tags": ["present", "singular", "third-person"]}, {"word": "leaking", "tags": ["participle", "present"]}, {"word": "leaked", "tags": ["participle", "past"]}, {"word": "leaked", "tags": ["past"]}], "senses": [{"definition": "(transitive) To allow fluid or gas to pass through an opening that should be sealed.", "tags": ["transitive"], "examples": ["The wells are believed to have been leaking oil for decades, long after the operating company ceased to exist."], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(intransitive) (of a fluid or gas) To pass through an opening that should be sealed.", "tags": ["intransitive"], "examples": ["The faucet has been leaking since last month.", "No one realized that propane gas was leaking from a rusty tank in the concession area, slowly filling the unventilated room."], "quotes": [], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "bg", "name": "Bulgarian"}, "word": "изтичам"}, {"language": {"code": "fi", "name": "Finnish"}, "word": "vuotaa"}, {"language": {"code": "haw", "name": "Hawaiian"}, "word": "kulu"}, {"language": {"code": "hi", "name": "Hindi"}, "word": "रिसाव"}, {"language": {"code": "hu", "name": "Hungarian"}, "word": "szivárog"}, {"language": {"code": "hu", "name": "Hungarian"}, "word": "szökik"}, {"language": {"code": "hu", "name": "Hungarian"}, "word": "csepeg"}, {"language": {"code": "hu", "name": "Hungarian"}, "word": "folyik"}, {"language": {"code": "it", "name": "Italian"}, "word": "trapelare"}, {"language": {"code": "ml", "name": "Malayalam"}, "word": "ചോരുക"}, {"language": {"code": "mi", "name": "Māori"}, "word": "turu"}, {"language": {"code": "mi", "name": "Māori"}, "word": "turuturu"}, {"language": {"code": "mi", "name": "Māori"}, "word": "pahī"}, {"language": {"code": "mi", "name": "Māori"}, "word": "komama"}, {"language": {"code": "pl", "name": "Polish"}, "word": "ulatniać"}, {"language": {"code": "pl", "name": "Polish"}, "wo