ples": [], "quotes": [{"text": "England were leaking penalties as Scotland played with pace and variety. Russell was starting to find his range and when he threaded through a grubber to Sean Maitland the winger did well to gather and keep the ball in play. Unfortunately, his pass inside just eluded Russell.", "reference": "2021 February 6, Graham Bean, “Scotland beat England at Twickenham for the first time in 38 years”, in The Scotsman:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(slang, sometimes euphemistic) To urinate.", "tags": ["euphemistic", "slang", "sometimes"], "examples": ["I had to leak in the woods since there were no toilets around."], "quotes": [{"text": "Why, you will allow vs ne're a Iourden, and then we leake in your Chimney: and your Chamber-lye breeds Fleas like a Loach.", "reference": "c. 1597 (date written), William Shakespeare, “The First Part of Henry the Fourth, […]”, in Mr. William Shakespeares Comedies, Histories, & Tragedies […] (First Folio), London: […] Isaac Iaggard, and Ed[ward] Blount, published 1623, →OCLC, [Act II, scene i]:"}, {"text": "Occasionally bums passed, Mexican mothers passed with children, and the prowl car came by and the cop got out to leak, but most of the time we were alone and mixing up our souls ever more and ever more till it would be terribly hard to say good-by.", "reference": "1957, Jack Kerouac, On the Road, Viking Press, →OCLC:"}, {"text": "Go and find a tree. I just leak against a^([sic]) oak over there.", "reference": "1965, Sam Selvon, The Housing Lark, Washington, D.C.: Three Continents Press, published 1990, page 125:"}], "synonyms": ["break the seal", "hit the head", "micturate", "pass water", "pee", "piddle", "piss", "slash", "take a leak", "take a piss", "take a whiz", "tinkle", "urinate", "void", "wee", "wee wee", "widdle", "whiz"], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(slang, US) To bleed.", "tags": ["US", "slang"], "examples": ["He shanked him, now he's leaking."], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "adjective", "pronunciations": [{"type": "ipa", "text": "/liːk/", "tags": []}], "forms": [{"word": "more leak", "tags": ["comparative"]}, {"word": "most leak", "tags": ["superlative"]}], "senses": [{"definition": "(obsolete) Leaky.", "tags": ["obsolete"], "examples": [], "quotes": [{"text": "Yet is the bottle leake, and bag so torne, / That all which I put in fals out anon […].", "reference": "1596, Edmund Spenser, “Book VI, Canto VIII”, in The Faerie Queene. […], London: […] [John Wolfe] for William Ponsonbie, →OCLC:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}], "source": {"url": "https://en.wiktionary.org/wiki/leak", "license": {"name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"}}}}