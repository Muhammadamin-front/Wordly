{"word": "intuition", "source": "freedictionaryapi", "data": {"word": "intuition", "entries": [{"language": {"code": "en", "name": "English"}, "partOfSpeech": "noun", "pronunciations": [{"type": "ipa", "text": "/ˌɪn.tjuːˈɪʃ.ən/", "tags": ["Received Pronunciation"]}, {"type": "ipa", "text": "/-t͡ʃuː-/", "tags": ["Received Pronunciation"]}, {"type": "ipa", "text": "/ˌɪn.tuˈɪʃ.ən/", "tags": ["Canada", "General American"]}, {"type": "ipa", "text": "/ˌɪn.tjuˈɪʃ.ən/", "tags": ["Canada", "General American"]}], "forms": [{"word": "intuitions", "tags": ["plural"]}, {"word": "intuïtion", "tags": ["alternative"]}], "senses": [{"definition": "Immediate cognition without the use of conscious rational processes.", "tags": ["countable", "uncountable"], "examples": [], "quotes": [{"text": "The native speaker's grammatical competence is reflected in two types of intuition which speakers have about their native language(s) — (i) intuitions about sentence well-formedness, and (ii) intuitions about sentence structure. The word intuition is used here in a technical sense which has become standardised in Linguistics: by saying that a native speaker has intuitions about the well-formedness and structure of sentences, all we are saying is that he has the ability to make judgments about whether a given sentence is well-formed or not, and about whether it has a particular structure or not. [...]", "reference": "1988, Andrew Radford, Transformational Grammar (Cambridge Textbooks in Linguistics), volume 1, Cambridge: Cambridge University Press, →ISBN, →OCLC, page 4:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "A perceptive insight gained by the use of this faculty.", "tags": ["countable", "uncountable"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "ar", "name": "Arabic"}, "word": "حَدْس"}, {"language": {"code": "bg", "name": "Bulgarian"}, "word": "интуиция"}, {"language": {"code": "ca", "name": "Catalan"}, "word": "intuïció"}, {"language": {"code": "cmn", "name": "Chinese Mandarin"}, "word": "直覺 /直觉"}, {"language": {"code": "cmn", "name": "Chinese Mandarin"}, "word": "直感"}, {"language": {"code": "da", "name": "Danish"}, "word": "intuition"}, {"language": {"code": "nl", "name": "Dutch"}, "word": "intuïtie"}, {"language": {"code": "fi", "name": "Finnish"}, "word": "intuitio"}, {"language": {"code": "fi", "name": "Finnish"}, "word": "vaisto"}, {"language": {"code": "fi", "name": "Finnish"}, "word": "aavistus"}, {"language": {"code": "fr", "name": "French"}, "word": "intuition"}, {"language": {"code": "gl", "name": "Galician"}, "word": "intuición"}, {"language": {"code": "de", "name": "German"}, "word": "Intuition"}, {"language": {"code": "el", "name": "Greek"}, "word": "διαίσθηση"}, {"language": {"code": "hi", "name": "Hindi"}, "word": "सहजबोध"}, {"language": {"code": "id", "name": "Indonesian"}, "word": "intuisi"}, {"language": {"code": "it", "name": "Italian"}, "word": "intuizione"}, {"language": {"code": "ja", "name": "Japanese"}, "word": "直覚"}, {"language": {"code": "ja", "name": "Japanese"}, "word": "直感"}, {"language": {"code": "ko", "name": "Korean"}, "word": "직관"}, {"language": {"code": "ko", "name": "Korean"}, "word": "직감"}, {"language": {"code": "mi", "name": "Māori"}, "word": "pūmanawa"}, {"language": {"code": "nb", "name": "Norwegian Bokmål"}, "word": "intuisjon"}, {"language": {"code": "nn", "name": "Norwegian Nynorsk"}, "word": "intuisjon"}, {"language": {"code": "pl", "name": "Polish"}, "word": "intuicja"}, {"language": {"code": "pt", "name": "Portuguese"}, "word": "intuição"}, {"language": {"code": "ro", "name": "Romanian"}, "word": "intuiție"}, {"language": {"code": "ru", "name": "Russian"}, "word": "интуи́ция"}, {"language": {"code": "es", "name": "Spanish"}, "word": "intuición"}, {"language": {"code": "sv", "name": "Swedish"}, "word": "intuition"}, {"language": {"code": "uk", "name": "Ukrainian"}, "word": "інтуї́ція"}], "subsenses": []}], 