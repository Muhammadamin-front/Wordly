lish"}, "partOfSpeech": "verb", "pronunciations": [{"type": "ipa", "text": "/ɑɹt͡ʃ/", "tags": ["General American"]}, {"type": "ipa", "text": "/ɑːt͡ʃ/", "tags": ["Received Pronunciation"]}, {"type": "ipa", "text": "/ɑɹk/", "tags": []}, {"type": "ipa", "text": "/ɑːk/", "tags": []}], "forms": [{"word": "arches", "tags": ["present", "singular", "third-person"]}, {"word": "arching", "tags": ["participle", "present"]}, {"word": "arched", "tags": ["participle", "past"]}, {"word": "arched", "tags": ["past"]}], "senses": [{"definition": "(transitive) To form into an arch shape.", "tags": ["transitive"], "examples": ["The cat arched its back."], "quotes": [{"text": "GBR will either be letting operating contracts or running rail companies directly, depending on which party wins the next General Election. Whichever it is, you can be forgiven for arching an eyebrow at an infrastructure company being placed in overall control.", "reference": "2024 March 6, Philip Haigh, “Comment: Who will run our railways?”, in RAIL, number 1004, page 3:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(transitive) To cover with an arch or arches.", "tags": ["transitive"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "adjective", "pronunciations": [{"type": "ipa", "text": "/ɑɹt͡ʃ/", "tags": ["General American"]}, {"type": "ipa", "text": "/ɑːt͡ʃ/", "tags": ["Received Pronunciation"]}, {"type": "ipa", "text": "/ɑɹk/", "tags": []}, {"type": "ipa", "text": "/ɑːk/", "tags": []}], "forms": [{"word": "archer", "tags": ["comparative"]}, {"word": "archest", "tags": ["superlative"]}], "senses": [{"definition": "Knowing, clever, mischievous.", "tags": [], "examples": ["I attempted to hide my emotions, but an arch remark escaped my lips."], "quotes": [{"text": "[He] spoke his request with so arch a leer.", "reference": "1710 July 14 (Gregorian calendar), Isaac Bickerstaff [et al., pseudonyms; Richard Steele et al.], “Monday, July 4, 1710”, in The Tatler, number 193; republished in [Richard Steele], editor, The Tatler, […], London stereotype edition, volume III, London: I. Walker and Co.; […], 1822, →OCLC:"}, {"text": "I was every day furniſhing the Court with ſome ridiculous Story; and Glumdalclitch, although ſhe loved me to Exceſs, yet was arch enough to inform the Queen, whenever I committed any Folly that ſhe thought would be diverting to her Majeſty.", "reference": "1726 October 28, [Jonathan Swift], “Several Adventures that Happened to the Author. […]”, in Travels into Several Remote Nations of the World. […] [Gulliver’s Travels], volume I, London: […] Benj[amin] Motte, […], →OCLC, part II (A Voyage to Brobdingnag), page 247:"}, {"text": "“Oh!” cried Mrs. Green, with an arch laugh, “you are acquainted with Monsieur Margot, then?”", "reference": "1828, [Edward Bulwer-Lytton], chapter XVI, in Pelham; or, The Adventures of a Gentleman. […], volume I, London: Henry Colburn, […], →OCLC, page 112:"}, {"text": "Blanche’s grey eyes gazed at Foker with such an arch twinkle that both of them burst out laughing […]", "reference": "1848 November – 1850 December, William Makepeace Thackeray, chapter 46, in The History of Pendennis. […], volume (please specify |volume=I or II), London: Bradbury and Evans, […], published 1849–1850, →OCLC:"}, {"text": "A certain melancholy that touched her countenance must have been of recent birth, for it had not yet altered the fine and youthful contours of her cheek, nor subdued the arch though resolute curve of her lips.", "reference": "1906 April, O. Henry [pseudonym; William Sydney Porter], “By Courier”, in The Four Million, New York, N.Y.: McClure, Phillips & Co, →OCLC:"}, {"text": "Lassiter ended there with dry humor, yet behind that was meaning. Jane blushed and made arch eyes at him.", "reference": "1912 January, Zane Grey, chapter 3, in Riders of the Purple Sage […], New York, N.Y.; London: Harper & Brothers Publishers, →OCLC:"}, {"text": "Not trusting filmgoers to catch the drift, Ms. Coppola underscores the women’s attempts to gussy up with snippets of arch dialogue.", "reference": "2017 June 30, Ruth La Ferla, “In ‘The Beguiled,’ Pretty Confections Whipped Up to Seduce”, in The New York Times, →ISSN:"}, {"text": "When you're watching a Wes Anderson film, you know it. Within seconds, you spot the symmetrical compositions, the horizontal camera moves, the blocks of garish colour, the san-serif lettering, the arch, wordy, vaguely melancholy humour and all the other elements that distinguish his comedies from everyone else's.", "reference": "2021 July 12, Nicholas Barber, “The French Dispatch: Four stars for Wes Anderson's latest”, in BBC:"}, {"text": "Ms. Brier specializes in point of view, or P.O.V., videos that confront relatable, often hateable characters, with a subtle sneer, gleefully rubbery body and arch delivery of generational catchphrases like “slay, queen” and “I got you,” often repeated for effect.", "reference": "2023 March 14, Alexandra Jacobs, “Your Annoying Roommate Is Slaying on TikTok”, in The New York Times:"}], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "fi", "name": "Finnish"}, "word": "ovela"}, {"language": {"code": "it", "name": "Italian"}, "word": "furbo"}, {"language": {"code": "pt", "name": "Portuguese"}, "word": "esperto"}, {"language": {"code": "ru", "name": "Russian"}, "word": "игри́вый"}, {"language": {"code": "ru", "name": "Russian"}, "word": "лука́вый"}, {"language": {"code": "es", "name": "Spanish"}, "word": "pícaro"}], "subsenses": []}, {"definition": "(Ireland) Cute, sly, prematurely wise.", "tags": ["Ireland"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "Principal; primary.", "tags": [], "examples": ["They were arch enemies."], "quotes": [{"text": "the most arch act of piteous massacre", "reference": "c. 1593 (date written), William Shakespeare, “The Tragedy of Richard the Third: […]”, in Mr. William Shakespeares Comedies, Histories, & Tragedies […] (First Folio), London: […] Isaac Iaggard, and Ed[ward] Blount, published 1623, →OCLC, [Act IV, scene iii]:"}, {"text": "Challenger the super scientist, Challenger the arch-pioneer, Challenger the first man of all men whom Mother Earth had been compelled to recognize.", "reference": "1928 February 25 – March 3, Arthur Conan Doyle, “When the World Screamed”, in The Professor Challenger Stories […], London: John Murray, […], published [1952], →OCLC, page 577:"}], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "fi", "name": "Finnish"}, "word": "pää-"}, {"language": {"code": "es", "name": "Spanish"}, "word": "principal"}], "subsenses": []}], "synonyms": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "noun", "pronunciations": [{"type": "ipa", "text": "/ɑɹt͡ʃ/", "tags": ["General American"]}, {"type": "ipa", "text": "/ɑːt͡ʃ/", "tags": ["Received Pronunciation"]}, {"type": "ipa", "text": "/ɑɹk/", "tags": []}, {"type": "ipa", "text": "/ɑːk/", "tags": []}], "forms": [{"word": "arches", "tags": ["plural"]}], "senses": [{"definition": "(obsolete) A chief.", "tags": ["obsolete"], "examples": [], "quotes": [{"text": "My worthy arch and patron comes to-night.", "reference": "c. 1593 (date written), William Shakespeare, “The Tragedy of Richard the Third: […]”, in Mr. William Shakespeares Comedies, Histories, & Tragedies […] (First Folio), London: […] Isaac Iaggard, and Ed[ward] Blount, published 1623, →OCLC, [Act IV, scene iii]:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(video games) Synonym of god (“person who owns and runs a multi-user dungeon”).", "tags": [], "examples": [], "quotes": [], "synonyms": ["god"], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []