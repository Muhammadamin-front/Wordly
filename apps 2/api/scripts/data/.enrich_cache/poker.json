ition": "(MLE, slang) A knife.", "tags": ["Multicultural London English", "slang"], "examples": [], "quotes": [{"text": "Key sense with the super-soaker\nLongest poker, leave man stressed like yoga", "reference": "2020 July 8, Kaygrab x D1, “Rapid”, 1:18–1:21:"}, {"text": "There is that guy that does with the pokings\nI step with my poker\nPlay, cuz right, you might get folded", "reference": "2021 March 6, Mloose (BG), “Real As Hell”, 0:58–1:02:"}], "synonyms": ["jook", "jooker", "ching", "ying", "bassy", "rambo", "pokey", "chete", "shank", "nank", "splash", "splasher", "cheffer", "wetter"], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": ["poker"], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "verb", "pronunciations": [{"type": "ipa", "text": "/ˈpoʊkɚ/", "tags": ["General American"]}, {"type": "ipa", "text": "/ˈpəʊkə/", "tags": ["Received Pronunciation"]}], "forms": [{"word": "pokers", "tags": ["present", "singular", "third-person"]}, {"word": "pokering", "tags": ["participle", "present"]}, {"word": "pokered", "tags": ["participle", "past"]}, {"word": "pokered", "tags": ["past"]}], "senses": [{"definition": "(transitive) To poke with a utensil such as a poker or needle.", "tags": ["transitive"], "examples": [], "quotes": [{"text": "The King continued pokering the fire with his back to the door, and took no notice of Lord Chesterfield.", "reference": "1796 July, “The Late Lord Chesterfield”, in The Aberdeen Magazine, volume 1, number 2, page 70:"}, {"text": "The lids have very pleasant designs pokered on with a hot needle.", "reference": "1939, Norah Gourlie, A Winter with Finnish Lapps, page 68:"}, {"text": "When she was gone Bell was afflicted by a mood that had her moving round the room, holding on to the yellow curtain, standing over her girls, stroking the sails of the model yacht, opening the drawer and looking at the broken brooch, pokering the fire, and shifting the kettle's position on the hearth.", "re