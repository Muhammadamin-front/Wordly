 [pseudonym; George Orwell], Nineteen Eighty-Four:"}, {"text": "In the face of expanding federal power, California in particular struggled to maintain control over its Chinese population.", "reference": "2005 April, Columbia Law Review:"}, {"text": "It has jailed environmental activists and is planning to limit the power of judicial oversight by handing a state-approved body a monopoly over bringing environmental lawsuits.", "reference": "2013 August 10, “Can China clean up fast enough?”, in The Economist, volume 408, number 8848:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(metonymic, chiefly in the plural) The people in charge of legal or political power, the government.", "tags": ["countable", "in plural", "metonymically", "uncountable"], "examples": [], "quotes": [], "synonyms": ["powers that be"], "antonyms": [], "translations": [{"language": {"code": "bg", "name": "Bulgarian"}, "word": "власти"}, {"language": {"code": "fi", "name": "Finnish"}, "word": "vallanpitäjät"}, {"language": {"code": "el", "name": "Greek"}, "word": "εξουσία"}, {"language": {"code": "el", "name": "Greek"}, "word": "κράτος"}, {"language": {"code": "ru", "name": "Russian"}, "word": "власть"}, {"language": {"code": "scn", "name": "Sicilian"}, "word": "auturità"}, {"language": {"code": "tr", "name": "Turkish"}, "word": "iktidar"}, {"language": {"code": "uk", "name": "Ukrainian"}, "word": "вла́да"}, {"language": {"code": "cy", "name": "Welsh"}, "word": "pŵer"}], "subsenses": []}, {"definition": "(metonymic) A strong or influential nation, company, or other such body.", "tags": ["countable", "metonymically", "uncountable"], "examples": ["In the 19th century, Britain and France were major colonial powers.", "Britain is no longer the maritime power that it once was."], "quotes": [{"text": "Most of the Himalayan rivers have been relatively untouched by dams near their sources. Now the two great Asian powers, India and China, are rushing to harness the