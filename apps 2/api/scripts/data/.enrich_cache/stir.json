ountable", "uncountable"], "examples": [], "quotes": [{"text": "Being advertised of some stirs raised by his unnatural sons in England.", "reference": "1612, Sir John Davies, Discoverie of the True Causes why Ireland was never entirely subdued:"}], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "bg", "name": "Bulgarian"}, "word": "суматоха"}, {"language": {"code": "ca", "name": "Catalan"}, "word": "avalot"}, {"language": {"code": "ca", "name": "Catalan"}, "word": "cridòria"}, {"language": {"code": "ca", "name": "Catalan"}, "word": "esvalot"}, {"language": {"code": "ca", "name": "Catalan"}, "word": "rebombori"}, {"language": {"code": "de", "name": "German"}, "word": "Aufruhr"}, {"language": {"code": "ga", "name": "Irish"}, "word": "corraí"}, {"language": {"code": "ja", "name": "Japanese"}, "word": "騒動"}, {"language": {"code": "la", "name": "Latin"}, "word": "turbellae"}, {"language": {"code": "pl", "name": "Polish"}, "word": "afera"}, {"language": {"code": "pl", "name": "Polish"}, "word": "bigos"}, {"language": {"code": "ru", "name": "Russian"}, "word": "волне́ния"}], "subsenses": []}, {"definition": "Agitation of thoughts; conflicting passions.", "tags": ["countable", "uncountable"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "bg", "name": "Bulgarian"}, "word": "вълнение"}, {"language": {"code": "fr", "name": "French"}, "word": "tumulte"}, {"language": {"code": "de", "name": "German"}, "word": "Erregung"}, {"language": {"code": "ja", "name": "Japanese"}, "word": "騒動"}, {"language": {"code": "ru", "name": "Russian"}, "word": "смяте́ние"}, {"language": {"code": "es", "name": "Spanish"}, "word": "revuelo"}, {"language": {"code": "es", "name": "Spanish"}, "word": "conmoción"}, {"language": {"code": "es", "name": "Spanish"}, "word": "alboroto"}], "subsenses": []}], "synonyms": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "noun", "pronunciations": [{"t