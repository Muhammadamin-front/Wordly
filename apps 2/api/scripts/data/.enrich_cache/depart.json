ge": {"code": "la", "name": "Latin"}, "word": "discedo"}, {"language": {"code": "la", "name": "Latin"}, "word": "digredior"}, {"language": {"code": "mi", "name": "Māori"}, "word": "marewa"}, {"language": {"code": "mi", "name": "Māori"}, "word": "wehe"}, {"language": {"code": "pt", "name": "Portuguese"}, "word": "partir"}, {"language": {"code": "pt", "name": "Portuguese"}, "word": "afastar-se de"}, {"language": {"code": "gd", "name": "Scottish Gaelic"}, "word": "fàg"}, {"language": {"code": "es", "name": "Spanish"}, "word": "escaparse de"}, {"language": {"code": "es", "name": "Spanish"}, "word": "salir de"}, {"language": {"code": "es", "name": "Spanish"}, "word": "arrancarse de"}, {"language": {"code": "es", "name": "Spanish"}, "word": "abandonar"}, {"language": {"code": "sv", "name": "Swedish"}, "word": "avlägsna sig från"}, {"language": {"code": "sv", "name": "Swedish"}, "word": "lämna"}, {"language": {"code": "ota", "name": "Ottoman Turkish"}, "word": "براقمق"}], "subsenses": []}, {"definition": "(ambitransitive, aviation) To lose control of an aircraft; to \"depart\" (sense 5) from controlled flight (with the aircraft as the direct object)", "tags": ["ambitransitive"], "examples": ["The envelope protection system allows the pilot to maneuver at high angles of attack without the risk of departing the airplane"], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(obsolete, transitive) To divide up; to distribute, share.", "tags": ["obsolete", "transitive"], "examples": [], "quotes": [{"text": "and so all the worlde seythe that betwyxte three knyghtes is departed clerely knyghthode, that is Sir Launcelot du Lake, Sir Trystrams de Lyones and Sir Lamerok de Galys—thes bere now the renowne.", "reference": "1470–1485 (date produced), Thomas Malory, “(please specify the chapter)”, in [Le Morte Darthur], book VII, [London: […] by William Caxton], published 31 July 1485, →OCLC; republished as H[einrich] Oskar Sommer, editor, Le Morte Darthur […], London: David Nutt, […], 1889, →OCLC:"}, {"text": "Then fortified hee his trenches, and departed them in foure quarters, wherein he made good store of fires, in such distance one from another, as are woont to be made in a campe.", "reference": "1595, Jacques Hurault, translated by Arthur Golding, Politicke, Moral, and Martial Discourses, London: Adam Islip, Book 3, Chapter 17, p. 458:"}, {"text": "Fyrst on that day yee shall serue a calfe sodden and blessed, and sodden egs with greene sauce, and set them before the most principall estate, and that Lorde because of his high estate, shal depart them al about him [...]", "reference": "1597, Thomas Dawson, The Second part of the good Hus-wiues Iewell, London: Edward White:"}, {"text": "That Deacons be not preferred before Priests, nor sit in their ranke, nor in their presence do distribute the Sacraments but only minister vnto them, and assist when they do distribute: but when there are no Priests there, in that case they may depart them.", "reference": "1602, “Extract out of the Acts of the Councell of Nice”, in Patrick Simon, transl., The Estate of the Church with the Discourse of Times, from the Apostles untill This Present, London: Thomas Creede, page 102:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(obsolete, transitive) To separate, part.", "tags": ["obsolete", "transitive"], "examples": ["1582, Stephen Batman (translator), Batman vppon Bartholome his booke De proprietatibus rerum, London: Thomas East, Book 5, Chapter 26, “Of the shoulders,”\nThe twisted forkes [i.e. fork-shaped bones] be néedfull to binde the shoulders, and to depart them from the breast."], "quotes": [{"text": "Syr knyght[,] said the two squyers that were with her[,] yonder are two knyghtes that fyghte for thys lady, goo thyder and departe them[…].", "reference": "1470–1485 (date produced), Thomas Malory, “(please specify the chapter)”, in [Le Morte Darthur], book IV, [London: […] by William Caxton], published 31 July 1485, →OCLC; republished as H[einrich] Oskar Sommer, editor, Le Morte Darthur […], London: David Nutt, […], 1889, →OCLC:"}, {"text": "I .N. take thee .N. to my wedded wife, to haue ⁊ to holde from this day forwarde, for better, for wurſe, for richer, for poorer, in ſickenes, and in health, to loue, and to cheriſhe, til death vs departe: according to Goddes holy ordeinaunce: And therto I plight thee my trouth.", "reference": "1549 March 7, Thomas Cranmer [et al.], compilers, “The Forme of Solemnizacion of Matrimonie”, in The Booke of the Common Prayer and Administration of the Sacramentes, […], London: […] Edowardi Whitchurche […], →OCLC, folio xiiii, recto:"}, {"text": "Thies be than the causes [...] for the whiche we depart our selues from the Athenyans [...]", "reference": "1550, Thomas Nicholls, transl., The Hystory Writtone by Thucidides the Athenyan, London, Book 3, Chapter 2, p. 74:"}, {"text": "Ere we depatt, wee'l ſhare a bounteous time / In different pleaſures.", "reference": "c. 1605–1608 (date written), William Shakespeare, “The Life of Tymon of Athens”, in Mr. William Shakespeares Comedies, Histories, & Tragedies […] (First Folio), London: […] Isaac Iaggard, and Ed[ward] Blount, published 1623, →OCLC, [Act I, scene i], page 82, column 2:"}, {"text": "Great is the affinitie of soule and body, neerely coupled and wedded by God, like Husband & Wife, for better and worse till death depart them.", "reference": "1617, Thomas Taylor, Dauids Learning, London: Henry Fetherstone, Dedicatory epistle:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": ["leave", "die", "deviate", "digress", "diverge", "sidetrack", "straggle", "vary", "leave"], "antonyms": ["arrive", "come", "stay", "live", "conform"]}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "noun", "pronunciations": [{"type": "ipa", "text": "/dɪˈpɑːt/", "tags": ["Received Pronunciation"]}, {"type": "ipa", "text": "/dɪˈpɑɹt/", "tags": ["General American"]}], "forms": [], "senses": [{"definition": "(obsolete) Division; separation, as of compound substances.", "tags": ["obsolete"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(obsolete) A going away; departure.", "tags": ["obsolete"], "examples": [], "quotes": [{"text": "at my depart for France", "reference": "1591 (date written), William Shakespeare, “The Second Part of Henry the Sixt, […]”, in Mr. William Shakespeares Comedies, Histories, & Tragedies. […] (First Folio), London: […] Isaac Iaggard, and Ed[ward] Blount, published 1623, →OCLC, [Act I, scene i]:"}, {"text": "Of that short Roll of friends writ in my heart\nWhich with thy name begins, since their depart,\nWhether in the English Provinces they be,\nOr drinke of Po, Sequan, or Danubie,", "reference": "1633, John Donne, “To M. I. L.”, in Poems, London: John Marriot, page 101:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}], "source": {"url": "https://en.wiktionary.org/wiki/depart", "license": {"name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"}}}}