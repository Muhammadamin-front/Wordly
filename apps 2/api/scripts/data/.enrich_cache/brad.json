{"word": "brad", "source": "freedictionaryapi", "data": {"word": "brad", "entries": [{"language": {"code": "en", "name": "English"}, "partOfSpeech": "noun", "pronunciations": [{"type": "ipa", "text": "/bɹad/", "tags": ["UK"]}, {"type": "ipa", "text": "/bɹæd/", "tags": ["General American", "Received Pronunciation"]}], "forms": [{"word": "brads", "tags": ["plural"]}], "senses": [{"definition": "A thin, small nail, with a slight projection at the top on one side instead of a head, or occasionally with a small domed head, similar to that of an escutcheon pin.", "tags": [], "examples": [], "quotes": [{"text": "Into the middle arch of each desk silver-headed brads had been hammered to form a lion, a bear, a ram, a dove, and in the midst a flaming torch.", "reference": "1936, Djuna Barnes, Nightwood, Faber & Faber, published 2007, page 5:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(US, elementary school usage) A paper fastener, a fastening device formed of thin, soft metal, such as shim brass, with a round head and a flat, split shank, which is spread after insertion in a hole in a stack of pages, in much the same way as a cotter pin or a split rivet.", "tags": ["US"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "verb", "pronunciations": [{"type": "ipa", "text": "/bɹad/", "tags": ["UK"]}, {"type": "ipa", "text": "/bɹæd/", "tags": ["General American", "Received Pronunciation"]}], "forms": [{"word": "brads", "tags": ["present", "singular", "third-person"]}, {"word": "bradding", "tags": ["participle", "present"]}, {"word": "bradded", "tags": ["participle", "past"]}, {"word": "bradded", "tags": ["past"]}], "senses": [{"definition": "(transitive) To attach using a brad.", "tags": ["transitive"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "sub