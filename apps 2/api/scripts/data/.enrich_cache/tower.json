tonyms": [], "translations": [], "subsenses": []}, {"definition": "(figurative) A strong refuge; a defence.", "tags": ["figuratively"], "examples": [], "quotes": [{"text": "Thou hast been a shelter for me, and a strong tower from the enemy.", "reference": "1611, The Holy Bible, […] (King James Version), London: […] Robert Barker, […], →OCLC, Psalms 61:3:"}, {"text": "A group of giraffes is called a tower.", "reference": "2019 June 6, “A gaggle, a confusion and a conspiracy - bizarre animal collective group names”, in BBC:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(business) Each of a set of information technology concerns within a business, which are treated separately so that they can be handled by different providers.", "tags": [], "examples": [], "quotes": [{"text": "Suppliers compete separately for the towers and service integrator and management contract, which assists the government in the integration and operation of its services.", "reference": "2013, Great Britain, The Impact of Government's ICT Savings Initiatives, National Audit Office, page 28:"}, {"text": "Service towers are significant IT functional areas, such as infrastructure, applications, security, etc., each possibly managed by a different service provider. The service integrator role is crucial for coordinating and integrating these service towers.", "reference": "2023, Cybellium Ltd, Mastering ISO-IEC 20000-1, page 108:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(cartomancy) The sixteenth named (trump or Major Arcana) card in many Tarot decks, usually deemed an ill omen.", "tags": [], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(cartomancy) The nineteenth Lenormand card, representing structure, bureaucracy, stability and loneliness.", "tags": [], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(collective) A group of giraffes.", "tags": ["collective"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(glassblowing) A metal stand used as a pivot to support a punty at a furnace.", "tags": [], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(historical) A tall fashionable headdress worn in the time of King William III and Queen Anne.", "tags": ["historical"], "examples": [], "quotes": [{"text": "Lay trains of amorous intrigues / In towers, and curls, and periwigs.", "reference": "1662 (indicated as 1663), [Samuel Butler], “[The First Part of Hudibras]”, in Hudibras. The First and Second Parts. […], London: […] John Martyn and Henry Herringman, […], published 1678; republished in A[lfred] R[ayney] Waller, editor, Hudibras: Written in the Time of the Late Wars, Cambridge, Cambridgeshire: University Press, 1905, →OCLC:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(obsolete) High flight; elevation.", "tags": ["obsolete"], "examples": [], "quotes": [{"text": "Nigh in her sight\nThe Bird of Jove, stoopt from his aerie tour,\nTwo Birds of gayest plume before him drove.", "reference": "1667, John Milton, “Book XI”, in Paradise Lost. […], London: […] [Samuel Simmons], and are to be sold by Peter Parker […]; [a]nd by Robert Boulter […]; [a]nd Matthias Walker, […], →OCLC; republished as Paradise Lost in Ten Books: […], London: Basil Montagu Pickering […], 1873, →OCLC:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": ["donjon"], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "verb", "pronunciations": [], "forms": [{"word": "towers", "tags": ["present", "singular", "third-person"]}, {"word": "towering", "tags": ["participle", "present"]}, {"word": "towered", "tags": ["participle", "past"]}, {"word": "towered", "tags": ["past"]}, {"word": "towre", "tags": ["alternative"]}], "senses": [{"definition": "(intransitive) To be very tall.", "tags": ["intransitive"], "examples": ["The office block towered into the sky."], "quotes": [{"text": "Potentilla and Ivory Daphne sat humpily about on the unfolded lawns, and ahead, there towered out enormous cliffs and fantastic pinnacles of what looked like Dolomite.", "reference": "1921, Reginald Farrer, chapter 10, in The Rainbow Bridge, London: E. Arnold & Co., page 181:"}, {"text": "This is itself a cheerless spot, particularly on a rainy day, when, overshadowed by the great massif of rock that towers in the background, and surrounded by the grey and cheerless quarries, it has a depressing character much in contrast with the green verdure encountered on the northern end of this interesting branch line.", "reference": "1954 August, H. M. Madgwick, “The Blaenau Festiniog Tunnel”, in Railway Magazine, page 569:"}, {"text": "Think of banking today and the image is of grey-suited men in towering skyscrapers.", "reference": "2013 August 3, “Revenge of the nerds”, in The Economist, volume 408, number 8847:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(intransitive) To be high or lofty; to soar.", "tags": ["intransitive"], "examples": [], "quotes": [{"text": "My lord protector's hawks do tower so well.", "reference": "1591 (date written), William Shakespeare, “The Second Part of Henry the Sixt, […]”, in Mr. William Shakespeares Comedies, Histories, & Tragedies. […] (First Folio), London: […] Isaac Iaggard, and Ed[ward] Blount, published 1623, →OCLC, [Act II, scene i]:"}, {"text": "When Hope, the eagle that tower’d, could see\nNo cliff beyond him in the sky,\nHis pinions were bent droopingly —\nAnd homeward turn’d his soften’d eye.", "reference": "1829, Edgar Allan Poe, “Tamerlane”, in Al Aaraaf, Tamerlane and Minor Poems:"}, {"text": "As we breasted the first summit, the precipitous mass of the Raven's Rock, towering some 250 ft. above the railway, looked grim and forbidding in the failing light, and distant Ben Wyves was shrouded in mist.", "reference": "1951 January, H. A. Vallance, “Kyle of Lochalsh Revisited”, in Railway Magazine, page 14:"}, {"text": "To the left towers the Jungfrau, with the train heading directly towards it.", "reference": "1960 December, Voyageur, “The Mountain Railways of the Bernese Oberland”, in Trains Illustrated, page 752:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(obsolete, transitive) To soar into.", "tags": ["obsolete", "transitive"], "examples": [], "quotes": [{"text": "Her state with oary feet; yet oft they quit\nThe dank, and, rising on stiff pennons, tower\nThe mid aerial sky", "reference": "1667, John Milton, “(please specify the page number)”, in Paradise Lost. […], London: […] [Samuel Simmons], and are to be sold by Peter Parker […]; [a]nd by Robert Boulter […]; [a]nd Matthias Walker, […], →OCLC; republished as Paradise Lost in Ten Books: […], London: Basil Montagu Pickering […], 1873, →OCLC:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "noun", "pronunciations": [{"type": "ipa", "text": "/ˈtəʊ.ə(ɹ)/", "tags": ["UK"]}, {"type": "ipa", "text": "/ˈtoʊ.əɹ/", "tags": ["General American"]}], "forms": [{"word": "towers", "tags": ["plural"]}, {"word": "towre", "tags": ["alternative"]}], "senses": [{"definition": "One who tows.", "tags": [], "examples": [], "quotes": [{"text": "But as the tower and towee reached the cross-roads again, another car, negligently driven, came round the corner, hit the Morris, and severed the tow rope, sending the unfortunate car back again into the shop window[…]", "reference": "1933, Henry Sturmey, H. Walter Staner, The Autocar:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}], "source": {"url": "https://en.wiktionary.org/wiki/tower", "license": {"name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"}}}}