anguage": {"code": "te", "name": "Telugu"}, "word": "ప్రయాణికుడు"}, {"language": {"code": "th", "name": "Thai"}, "word": "นักเดินทาง"}, {"language": {"code": "th", "name": "Thai"}, "word": "ผู้เดินทาง"}, {"language": {"code": "bo", "name": "Tibetan"}, "word": "འགྲུལ་པ"}, {"language": {"code": "bo", "name": "Tibetan"}, "word": "འགྲུལ་བཞུད་བྱེད་མཁན"}, {"language": {"code": "tr", "name": "Turkish"}, "word": "yolcu"}, {"language": {"code": "tr", "name": "Turkish"}, "word": "gezgin"}, {"language": {"code": "tr", "name": "Turkish"}, "word": "seyyah"}, {"language": {"code": "ota", "name": "Ottoman Turkish"}, "word": "یولجی"}, {"language": {"code": "tk", "name": "Turkmen"}, "word": "syýahatçy"}, {"language": {"code": "uk", "name": "Ukrainian"}, "word": "мандрі́вник"}, {"language": {"code": "uk", "name": "Ukrainian"}, "word": "мандрі́вниця"}, {"language": {"code": "uk", "name": "Ukrainian"}, "word": "подоро́жник"}, {"language": {"code": "uk", "name": "Ukrainian"}, "word": "подоро́жниця"}, {"language": {"code": "ur", "name": "Urdu"}, "word": "مُسافِر"}, {"language": {"code": "ur", "name": "Urdu"}, "word": "یاتْری"}, {"language": {"code": "ur", "name": "Urdu"}, "word": "سَیَّاح"}, {"language": {"code": "ug", "name": "Uyghur"}, "word": "ساياھەتچى"}, {"language": {"code": "uz", "name": "Uzbek"}, "word": "sayyoh"}, {"language": {"code": "uz", "name": "Uzbek"}, "word": "sayohatchi"}, {"language": {"code": "vi", "name": "Vietnamese"}, "word": "người đi du lịch"}, {"language": {"code": "vo", "name": "Volapük"}, "word": "tävan"}, {"language": {"code": "vo", "name": "Volapük"}, "word": "hitävan"}, {"language": {"code": "vo", "name": "Volapük"}, "word": "jitävan"}, {"language": {"code": "cy", "name": "Welsh"}, "word": "teithiwr"}], "subsenses": []}, {"definition": "(dated) A salesman who travels from place to place on behalf of a company.", "tags": ["dated"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(British) Someone who lives (particularly in the UK) in a caravan, bus or other vehicle rather than a fixed abode.", "tags": ["British"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(Ireland) Alternative letter-case form of Traveller.", "tags": ["Ireland", "alt of"], "examples": [], "quotes": [{"text": "It provoked criticism for its portrayal of a woman who leaves her marriage for life with a solitary traveler. Irish women did not do those sorts of things, the audiences felt (although the plot came from a story told to Synge on Inis Meain).", "reference": "2010, R. Todd Felton, A Journey Into Ireland's Literary Revival, →ISBN, page 213:"}, {"text": "Kevin chases after him through a forest and finds the horse with Joseph Maguire (Ian Holm), a poetry-reciting traveler (Irish gypsy).", "reference": "2012, Mark Connelly, The IRA on Film and Television: A History, →ISBN, page 212:"}, {"text": "...settled Irish people of Southern Ireland treat the traveler boys with racist hostility (2001 180–81).", "reference": "2012, Maria Pramaggiore, Irish and African American Cinema, →ISBN, page 152:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "A list and record of instructions that follows a part in a manufacturing process.", "tags": [], "examples": [], "quotes": [], "synonyms": ["router"], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(electrical engineering) One of the wires connecting the two members of a pair of three-way switches.", "tags": [], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(nautical) A metal ring that moves freely on part of a ship’s rigging.", "tags": [], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(television, theater) A rail or track for a sliding curtain.", "tags": [], "examples": [], "quotes": [{"text": "That would detract from the austerity of Rudkin's study, and a curtain on a traveler is always slid across the stage […]", "reference": "1977, New York Theatre Critics' Reviews, volumes 38-39, page 134:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(bridge) A sheet of paper that is circulated with the board of cards, on which players record their scores.", "tags": [], "examples": [], "quotes": [{"text": "At the conclusion of play, the scores from all the travelers get entered into a computer.", "reference": "2008, David Galt, Teach Yourself VISUALLY Bridge, →ISBN, page 263:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(US, Mississippi Delta) A styrofoam cup filled with liquor and usually ice, to be taken away from a place.", "tags": ["US"], "examples": [], "quotes": [{"text": "Nowhere else in the world had I seen such gigantic measures of liquor poured, such widespread enthusiasm for Bloodies and Mimosas on weekend mornings, or such firm insistence on giving sixteen-ounce Styrofoam cups loaded with iced liquor to guests leaving a party, so they might have a \"traveler\" for the drive home.\nAt a bar in Yazoo City, the bartender asked me if I wanted to \"go tall\" with my bourbon on the rocks. I didn't know what he meant, but it sounded encouraging. \"Sure,\" I said, \"Let's go tall.\" He filled up a pint glass with ice. Then he filled it to the brim with bourbon. When I got up to leave with about half the drink gone, he poured the rest of it into a Styrofoam cup, assuming I would want a traveler.", "reference": "2015, Richard Grant, Dispatches from Pluto: Lost and Found in the Mississippi Delta:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(textiles) Part of the apparatus in various fiber spinning processes (for spinning fiber to thread or yarn); several types exist.", "tags": [], "examples": ["ring traveler", "ring traveller"], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": ["wayfarer", "bird of passage", "gadabout", "itinerant", "peregrinator", "rambler", "rover", "traveller", "voyager", "wanderer"], "antonyms": []}], "source": {"url": "https://en.wiktionary.org/wiki/traveller", "license": {"name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"}}}}