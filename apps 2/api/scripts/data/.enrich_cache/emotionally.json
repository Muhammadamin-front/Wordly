{"word": "emotionally", "source": "freedictionaryapi", "data": {"word": "emotionally", "entries": [{"language": {"code": "en", "name": "English"}, "partOfSpeech": "adverb", "pronunciations": [{"type": "ipa", "text": "/ɪˈməʊʃənəli/", "tags": ["Received Pronunciation"]}, {"type": "ipa", "text": "/ɪˈməʊʃənli/", "tags": ["Received Pronunciation"]}, {"type": "ipa", "text": "/ɪˈmoʊʃənəli/", "tags": ["Canada", "General American"]}, {"type": "ipa", "text": "/iˈmoʊʃənəli/", "tags": ["Canada", "General American"]}], "forms": [{"word": "more emotionally", "tags": ["comparative"]}, {"word": "most emotionally", "tags": ["superlative"]}], "senses": [{"definition": "In an emotional manner; displaying emotion.", "tags": [], "examples": ["\"For a long time, I thought I'd never live to see this day,\" he said emotionally. \"Thank you all for everything you did in my behalf.\""], "quotes": [{"text": "Few concepts are as emotionally charged as that of race. The word conjures up a mixture of associations—culture, ethnicity, genetics, subjugation, exclusion and persecution. But is the tragic history of efforts to define groups of people by race really a matter of the misuse of science, the abuse of a valid biological concept?", "reference": "2012 March-April, Jan Sapp, “Race Finished”, in American Scientist, volume 100, number 2, archived from the original on 05 Sep 2015, page 164:"}], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "ca", "name": "Catalan"}, "word": "emocionalment"}, {"language": {"code": "cs", "name": "Czech"}, "word": "citově"}, {"language": {"code": "cs", "name": "Czech"}, "word": "emocionálně"}, {"language": {"code": "da", "name": "Danish"}, "word": "følelsesmæssig"}, {"language": {"code": "da", "name": "Danish"}, "word": "emotionel"}, {"language": {"code": "eo", "name": "Esperanto"}, "word": "emocie"}, {"language": {"code": "gl", "name": "Galician"}, "word": "emocionalmente"}, {"language": {"code": "el", "name": "Greek"}, "word": "συναισθηματι