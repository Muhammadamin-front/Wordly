s": [], "subsenses": []}], "synonyms": ["allow", "permit"], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "noun", "pronunciations": [{"type": "ipa", "text": "/lɛt/", "tags": []}], "forms": [{"word": "lets", "tags": ["plural"]}, {"word": "lett", "tags": ["alternative", "archaic"]}, {"word": "lettest", "tags": ["alternative", "archaic", "past", "present", "second-person", "singular"]}, {"word": "letteth", "tags": ["alternative", "archaic", "present", "singular", "third-person"]}], "senses": [{"definition": "The allowing of possession of a property etc. in exchange for rent.", "tags": [], "examples": [], "quotes": [{"text": "Then he says “You would call it a Good Let, Madam?”\n“O certainly a Good Let sir.”", "reference": "1854, Charles Dickens, Christmas Stories, page 317:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "verb", "pronunciations": [{"type": "ipa", "text": "/lɛt/", "tags": []}], "forms": [{"word": "lets", "tags": ["present", "singular", "third-person"]}, {"word": "letting", "tags": ["participle", "present"]}, {"word": "letted", "tags": ["past"]}, {"word": "let", "tags": ["participle", "past"]}, {"word": "lett", "tags": ["alternative", "archaic"]}, {"word": "lettest", "tags": ["alternative", "archaic", "past", "present", "second-person", "singular"]}, {"word": "letteth", "tags": ["alternative", "archaic", "present", "singular", "third-person"]}], "senses": [{"definition": "(archaic) To hinder, prevent, impede, hamper, cumber; to obstruct (someone or something).", "tags": ["archaic"], "examples": [], "quotes": [{"text": "He who now letteth will let, until he be taken out of the way.", "reference": "1611, The Holy Bible, […] (King James Version), London: […] Robert Barker, […], →OCLC, 2 Thessalonians 2:7:"}, {"text": "Sir King, mine ancient wound is hardly whole, / And lets me from the saddle; […]", "reference": "1859, Alfred Tennyson, “Elaine”, in Idylls of the King, London: Edward Moxon & Co., […], →OCLC, page 152:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(obsolete) To prevent someone from doing something; also to prevent something from happening.", "tags": ["obsolete"], "examples": [], "quotes": [{"text": "& there was syr Mordred redy awaytynge vpon his londage to lette his owne fader to lāde vp the lande that he was kyng ouer.\n\"And there was Sir Mordred ready awaiting upon his landing, to let his own father to land upon the land that he was king over.\"", "reference": "1485, Thomas Malory, Le Morte Darthur Book XXI, Chapter ii, leaf 421r:"}, {"text": "And as they went on their waye, they cam unto a certayne water, and the gelded man sayde: Se here is water, what shall lett me to be baptised?", "reference": "1526, [William Tyndale, transl.], The Newe Testamẽt […] (Tyndale Bible), [Worms, Germany: Peter Schöffer], →OCLC, Acts viij:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(obsolete) To tarry or delay.", "tags": ["obsolete"], "examples": [], "quotes": [{"text": "And for that strake I would not let, / Another upon him soon I set, […]", "reference": "1826, Early Metrical Tales; Including the History of Sir Egeir, Sir Gryme, and Sir Gray-Steill, Edinburgh, The History of Sir Eger, Sir Grahame, And Sir Gray-Steel, page 7:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "noun", "pronunciations": [{"type": "ipa", "text": "/lɛt/", "tags": []}], "forms": [{"word": "lets", "tags": ["plural"]}, {"word": "lett", "tags": ["alternative", "archaic"]}, {"word": "lettest", "tags": ["alternative", "archaic", "past", "present", "second-person", "singular"]}, {"word": "letteth", "tags": ["alternative", "archaic", "present", "singular", "third-person"]}], "senses": [{"definition": "(obsolete or law) An obstacle or hindrance.", "tags": ["obsolete"], "examples": ["without let or hindrance"], "quotes": [{"text": "[E]ver conſider vvhether our doings be to the let of our ſalvation or not.", "reference": "1552 June 21 (Gregorian calendar), Hugh Latimer, Augustine Bernher, compiler, “Sermon XXV. Preached on the Twenty First Sunday after Trinity.”, in The Sermons of the Right Reverend Father in God, Master Hugh Latimer, Bishop of Worcester. […], volume II, London: […] J. Scott, […], published 1758, →OCLC, page 541:"}, {"text": "And Cadmus saw his campanie make tarience in that sort / He marveld what should be their let, and went to seeke them out.", "reference": "1567, Ovid, “The Third Booke”, in Arthur Golding, transl., The XV. Bookes of P. Ouidius Naso, Entytuled Metamorphosis, […], London: […] Willyam Seres […], →OCLC, lines 60–61:"}, {"text": "Paulus Emilius going to the glorious expedition of Macedon, advertised the people of Rome during his absence not to speake of his actions: For the licence of judgements is an especiall let in great affaires.", "reference": "1603, Michel de Montaigne, chapter 16, in John Florio, transl., The Essayes […], book II, London: […] Val[entine] Simmes for Edward Blount […], →OCLC:"}], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "pt", "name": "Portuguese"}, "word": "obstáculo"}, {"language": {"code": "sh", "name": "Serbo-Croatian"}, "word": "prepreka"}], "subsenses": []}, {"definition": "(tennis) The hindrance caused by the net during serve, only if the ball falls legally.", "tags": [], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "pt", "name": "Portuguese"}, "word": "obstáculo"}, {"language": {"code": "sh", "name": "Serbo-Croatian"}, "word": "prepreka"}], "subsenses": []}], "synonyms": [], "antonyms": []}], "source": {"url": "https://en.wiktionary.org/wiki/let", "license": {"name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"}}}}