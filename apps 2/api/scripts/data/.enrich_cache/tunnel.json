ge": {"code": "ota", "name": "Ottoman Turkish"}, "word": "تونل"}, {"language": {"code": "tk", "name": "Turkmen"}, "word": "tonnel"}, {"language": {"code": "tk", "name": "Turkmen"}, "word": "tunel"}, {"language": {"code": "uk", "name": "Ukrainian"}, "word": "туне́ль"}, {"language": {"code": "ur", "name": "Urdu"}, "word": "سُرَن٘گ"}, {"language": {"code": "uz", "name": "Uzbek"}, "word": "tunnel"}, {"language": {"code": "vec", "name": "Venetan"}, "word": "stol"}, {"language": {"code": "vi", "name": "Vietnamese"}, "word": "hầm"}, {"language": {"code": "vi", "name": "Vietnamese"}, "word": "đường hầm"}, {"language": {"code": "vi", "name": "Vietnamese"}, "word": "hầm chui"}, {"language": {"code": "cy", "name": "Welsh"}, "word": "twnnel"}, {"language": {"code": "yi", "name": "Yiddish"}, "word": "טונעל"}], "subsenses": []}, {"definition": "A passage through or under some obstacle.", "tags": [], "examples": [], "quotes": [{"text": "But very soon he grew to like it, for the Boy used to talk to him, and made nice tunnels for him under the bedclothes that he said were like the burrows the real rabbits lived in.", "reference": "1921 June, Margery Williams, “The Velveteen Rabbit: Or How Toys Become Real”, in Harper’s Bazar, volume LVI, number 6 (2504 overall), New York, N.Y.: International Magazine Company, →ISSN, →OCLC:"}, {"text": "Tunnels often feature in fictional journeys, so I will end with quotations from a fairly recent novel, Howard Spring's \"Fame is the Spur\", published in 1940, in which there is a journey from Manchester to Bradford via the Calder Valley route: \"Ay, we're going through Todmorden. We'll soon be in t' tunnel, and when we get to t' other end we'll be in Yorkshire,\" and \"Ah think this is t' filthiest tunnel in t' world.\"", "reference": "1957 May 25, Neil Caplan, “Railways in English Fiction”, in Railway Magazine, page 350:"}, {"text": "There are more than 1,500 railway tunnels in Britain and the majority are still in use, carrying working tracks beneath Britain's most inconvenient geographic features.", "reference": "2020 August 26, Tim Dunn, “Great railway bores of our time!”, in Rail, page 42:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "A hole in the ground made by an animal, a burrow.", "tags": [], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(computing, networking) A wrapper for a protocol that cannot otherwise be used because it is unsupported, blocked, or insecure.", "tags": [], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "A vessel with a broad mouth at one end, a pipe or tube at the other, for conveying liquor, fluids, etc., into casks, bottles, or other vessels; a funnel.", "tags": [], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "The opening of a chimney for the passage of smoke; a flue.", "tags": [], "examples": [], "quotes": [{"text": "And one great chimney, whose long tonnell thence, / The smoke forth threw", "reference": "1590, Edmund Spenser, “Book II, Canto IX”, in The Faerie Queene. […], London: […] [John Wolfe] for William Ponsonbie, →OCLC, stanza 29:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(mining) A level passage driven across the measures, or at right angles to veins which it is desired to reach; distinguished from the drift, or gangway, which is led along the vein when reached by the tunnel.", "tags": [], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(figurative) Anything that resembles a tunnel.", "tags": ["figuratively"], "examples": [], "quotes": [{"text": "Especially in the Eden Valley, trees create what is almost a green tunnel (particularly in summer).", "reference": "2021 October 20, Mark Rand, “S&C: a line fit for tourists... and everyone?”, in RAIL, number 942, page 43:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "verb", "pronunciations": [{"type": "ipa", "text": "/ˈtʌn(ə)l/", "tags": []}], "forms": [{"word": "tunnels", "tags": ["present", "singular", "third-person"]}, {"word": "tunneling", "tags": ["US", "participle", "present"]}, {"word": "tunnelling", "tags": ["UK", "participle", "present"]}, {"word": "tunneled", "tags": ["US", "participle", "past"]}, {"word": "tunneled", "tags": ["US", "past"]}, {"word": "tunnelled", "tags": ["UK", "participle", "past"]}, {"word": "tunnelled", "tags": ["UK", "past"]}], "senses": [{"definition": "(transitive) To make a tunnel through or under something; to burrow.", "tags": ["transitive"], "examples": [], "quotes": [{"text": "The 1955 Act gave powers for compulsory acquisition of \"easements\", or permission to tunnel beneath dwelling houses instead of, as had previously been necessary, following approximately the course of surface roads.", "reference": "1962 October, “London gets its Victoria tube”, in Modern Railways, page 258:"}, {"text": "The 6.5km route is agreed from a junction with the relief lines of the Great Western main line to the west of Slough, the new link would tunnel under the M25 to reach Heathrow's Terminal 5 station, where space has been set aside to accommodate services from the west.", "reference": "2019 October, Ruth Bagley tells James Abbott, “Crunch time for Heathrow western link”, in Modern Railways, page 74:"}], "synonyms": ["undermine"], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(intransitive) To dig a tunnel.", "tags": ["intransitive"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(computing, networking) To transmit something through a tunnel (wrapper for an insecure or unsupported protocol).", "tags": [], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(transitive, medicine) To insert a catheter into a vein to allow long-term use.", "tags": ["transitive"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(physics) To undergo the quantum-mechanical phenomenon where a particle penetrates through a barrier that it classically cannot surmount.", "tags": [], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}], "source": {"url": "https://en.wiktionary.org/wiki/tunnel", "license": {"name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"}}}}