ransitive"], "examples": [], "quotes": [{"text": "[…] while the King and Godwine sate at the table, accompanied with others of the nobilitie, it chanced the cupbearer (as he brought wine to the bourd) to slip with the one foote, and yet by good strength of his other leg, to recover himselfe without falling […]", "reference": "1826, William Lambarde, A Perambulation of Kent:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "To try or risk.", "tags": [], "examples": ["Shall we carry the umbrella, or chance a rainstorm?"], "quotes": [{"text": "He does chance it in stocks, but he's always played on the square, if you call stocks gambling.", "reference": "1890, William Dean Howells, A Hazard of New Fortunes:"}], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "bg", "name": "Bulgarian"}, "word": "рискувам"}, {"language": {"code": "ca", "name": "Catalan"}, "word": "arriscar-se"}, {"language": {"code": "da", "name": "Danish"}, "word": "ta chancen"}, {"language": {"code": "da", "name": "Danish"}, "word": "risikere"}, {"language": {"code": "nl", "name": "Dutch"}, "word": "wagen"}, {"language": {"code": "eo", "name": "Esperanto"}, "word": "hazardi"}, {"language": {"code": "fi", "name": "Finnish"}, "word": "ottaa riski"}, {"language": {"code": "de", "name": "German"}, "word": "riskieren"}, {"language": {"code": "de", "name": "German"}, "word": "wagen"}, {"language": {"code": "hu", "name": "Hungarian"}, "word": "megkockáztat"}, {"language": {"code": "ro", "name": "Romanian"}, "word": "risca"}, {"language": {"code": "es", "name": "Spanish"}, "word": "chancear"}, {"language": {"code": "es", "name": "Spanish"}, "word": "chansear"}, {"language": {"code": "sw", "name": "Swahili"}, "word": "nafasi"}, {"language": {"code": "sv", "name": "Swedish"}, "word": "chansa"}, {"language": {"code": "sv", "name": "Swedish"}, "word": "riskera"}, {"language": {"code": "tr", "name": "Turkish"}, "word": "riske etmek"}], "subsenses": []}, 