ntonyms": ["forget", "remind", "shut the door on"]}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "verb", "pronunciations": [], "forms": [{"word": "remembers", "tags": ["present", "singular", "third-person"]}, {"word": "remembering", "tags": ["participle", "present"]}, {"word": "remembered", "tags": ["participle", "past"]}, {"word": "remembered", "tags": ["past"]}, {"word": "re-member", "tags": ["alternative"]}], "senses": [{"definition": "(rare) Alternative form of re-member.", "tags": ["alt of", "alternative", "rare"], "examples": [], "quotes": [{"text": "knit 'this scattered corn into one mutual sheaf, / these broken limbs again into one body' - in other words, how to resurrect the dismembered god, to remember Osiris. Yet the only body made whole in these expert, lowering poems is the body of this death.", "reference": "1982, Book Review Digest, volume 78, page 824:"}, {"text": "According to these mysteries, the rites of fashioning or remembering Osiris came to be interpreted as remembering Egypt. Egypt was the body of Osiris, dismembered and scattered across the land.", "reference": "2008, Jan Assmann, Of God and Gods: Egypt, Israel, and the Rise of Monotheism, page 42:"}, {"text": "She remembered Osiris by putting his pieces back together and mating with him one last time, conceiving Horus, who eventually avenged his father's death.", "reference": "2010, Sandra Ingerman, Medicine for the Earth, page 100:"}, {"text": "To dismember is to tear apart; / To re-member is to put back together. / The old must be dismembered / So that which was prior to it / May be remembered. / Therefore, to re-mind is / To dismember and then re-member.", "reference": "2012, Roy Melvyn, The Lost Writings of Wu Hsin: Pointers to Non Duality in Five Volumes, Lulu Press, Inc, →ISBN:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": ["bear in mind", "bethink", "keep in mind", "mind", "recall", "recollect", "remember", "retrieve", "thi