ntonyms": [], "translations": [], "subsenses": []}, {"definition": "A female goat.", "tags": [], "examples": [], "quotes": [{"text": "Breeding is a consuming goal, and the ascendance of the sex drive is nearly as apparent in the behavior of a mountain goat billy. So given over is he to following and defending a succession of nannies as he searches for one in heat (estrus), he loses interest in food altogether; […]", "reference": "1983, Douglas H. Chadwick, A Beast the Color of Winter: The Mountain Goat Observed, Bison Books, published 2002, →ISBN, page 159:"}, {"text": "Nannies and billies look very similar, both having dangerously sharp, curved black horns.", "reference": "2005, Richard Cannings, The Rockies: A Natural History, Greystone Books, published 2005, →ISBN, page 103:"}, {"text": "A farmer friend keeps a video camera in the barn so she can turn on her goat cam and observe her animals at any time of the day or night. A baby monitor picks up the sounds of a nanny when she goes into labor—if the nanny is one who changes the usual pitch of her voice or nervously bleats during kidding.", "reference": "2013, Janet Hurst, The Whole Goat Handbook: Recipes, Cheese, Soap, Crafts & More, Voyageur Press, published 2013, →ISBN, page 28:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(mining) Synonym of sylvester (“device for pulling out pit props”).", "tags": [], "examples": [], "quotes": [], "synonyms": ["sylvester"], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": ["nanny goat", "housemother"], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "verb", "pronunciations": [{"type": "ipa", "text": "/ˈnæni/", "tags": []}], "forms": [{"word": "nannies", "tags": ["present", "singular", "third-person"]}, {"word": "nannying", "tags": ["participle", "present"]}, {"word": "nannied", "tags": ["participle", "past"]}, {"word": "nannied", "tags": ["past"]}], "senses": [{"definition": "(intransitive, transitive) To serve as a nanny.", "tags": ["intransitive", "transitive"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(transitive, derogatory) To treat like a nanny's charges; to coddle.", "tags": ["derogatory", "transitive"], "examples": [], "quotes": [{"text": "In real life, says a Democratic campaign aide, members of Congress are too nannied by staff to stride about hatching plots, one-on-one.", "reference": "2013 February 21, “Unreality television”, in The Economist:"}, {"text": "All politicians seem worried. After 40-plus years of being nannied by the EU they are now faced with having to stand on their own two feet.", "reference": "2016 June 24, Angie Willems, “'A drastic change was necessary' - Coventry reacts to Brexit vote”, in Coventry Telegraph:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}], "source": {"url": "https://en.wiktionary.org/wiki/nanny", "license": {"name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"}}}}