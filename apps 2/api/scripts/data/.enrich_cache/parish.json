 [{"text": "Atlantic gales constantly buffet Morwenstow, whose seven hamlets together constitute Cornwall's most northerly parish. The village is dotted with trees moulded into weird shapes by the wind, and above the trees rise the vicarage chimneystacks resembling miniature church towers.", "reference": "1980, AA Book of British Villages, Drive Publications Ltd, page 288:"}], "synonyms": ["civil parish", "civil parish"], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "An administrative subdivision in the U.S. state of Louisiana that is equivalent to a county in other U.S. states.", "tags": [], "examples": [], "quotes": [], "synonyms": ["civil parish"], "antonyms": [], "translations": [], "subsenses": []}]}], "synonyms": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "verb", "pronunciations": [{"type": "ipa", "text": "/ˈpæɹɪʃ/", "tags": ["Received Pronunciation"]}, {"type": "ipa", "text": "/ˈpæɹɪʃ/", "tags": ["General American"]}, {"type": "ipa", "text": "/ˈpɛɹɪʃ/", "tags": []}, {"type": "ipa", "text": "/ˈpaɾɪʃ/", "tags": ["Scotland", "Wales"]}], "forms": [{"word": "parishes", "tags": ["present", "singular", "third-person"]}, {"word": "parishing", "tags": ["participle", "present"]}, {"word": "parished", "tags": ["participle", "past"]}, {"word": "parished", "tags": ["past"]}, {"word": "paroch", "tags": ["alternative", "Scotland", "obsolete"]}], "senses": [{"definition": "(transitive) To place (an area, or rarely a person) into one or more parishes.", "tags": ["transitive"], "examples": ["[…] [m]akes possible, through the aid of the rural ministers, the development of the various phases of the District program, such as (a) Parishing of the District; (b) Interdenominational adjustment in the interest of rural religious advance […]"], "quotes": [{"text": "Father Malachy, a distant cousin, who was parished somewhere in the depths of Co. Monaghan, sat firmly in the chair in the corner, sipping his tea from a china cup.", "reference": "1972, Winter's Tales from Ireland, volume 2, page 55:"}, {"text": "Consequently, approaching half of the non-metropolitan population of England is parished (Table 2.2).\n[…]\nThe South West and East Midlands are also particularly well parished while the North West, West Midlands and South East are poorly parished.", "reference": "1992, Parish and town councils in England: a survey, pages 17 and 21:"}, {"text": "Dr Whitehead: In your written evidence, you have all in different ways made the distinction between NDOs in parished areas and NDOs in non-parished areas, […]", "reference": "2011, Sustainable development in the Localism Bill: third report, →ISBN, page 5:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(intransitive) To visit residents of a parish.", "tags": ["intransitive"], "examples": [], "quotes": [{"text": "[…] a chair immediately opposite to Tressady's place remained vacant. It was being kept for the eldest son of the house, his mother explaining carelessly to Lord Fontenoy that she believed he was \"Out parishing somewhere, as usual.\"", "reference": "1896, Mrs. Humphry Ward, Sir George Tressady, volume 1, →ISBN:"}, {"text": "\"You will take pleasure in parishing. Mother used to parish.\"\n\"How do you know I like parishing?\"\n\"Your uncle said so.\"\n\"Oh! did he?\"\n\"And you may like the rectory people; it's a fine old house, and often full of visitors.\"", "reference": "1903, Maxwell Gray, Richard Rosny, page 210:"}, {"text": "\"Are you going ‘parishing’ this morning?\" inquired Diana, as she watched him fill and light his pipe.", "reference": "1921, Margaret Pedler, The Splendid Folly, page 46:"}, {"text": "In 1916 he was Rector of Hampton Bishop, a village on the River Wye outside Hereford, and one day while “parishing”, as he called visiting his flock, a farmers' wife, a Mrs. Christopher Field, gave him an account of her father's death-bed; […]", "reference": "2013, Ann Bridge, Moments of Knowing:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}, {"language": {"code": "en", "name": "English"}, "partOfSpeech": "verb", "pronunciations": [{"type": "ipa", "text": "/ˈpæɹɪʃ/", "tags": ["Received Pronunciation"]}, {"type": "ipa", "text": "/ˈpæɹɪʃ/", "tags": ["General American"]}, {"type": "ipa", "text": "/ˈpɛɹɪʃ/", "tags": []}, {"type": "ipa", "text": "/ˈpaɾɪʃ/", "tags": ["Scotland", "Wales"]}], "forms": [{"word": "parishes", "tags": ["present", "singular", "third-person"]}, {"word": "parishing", "tags": ["participle", "present"]}, {"word": "parished", "tags": ["participle", "past"]}, {"word": "parished", "tags": ["past"]}, {"word": "paroch", "tags": ["alternative", "Scotland", "obsolete"]}], "senses": [{"definition": "Pronunciation spelling of perish, representing Mary–marry–merry merger English.", "tags": ["alt of", "pronunciation spelling"], "examples": [], "quotes": [], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": [], "antonyms": []}], "source": {"url": "https://en.wiktionary.org/wiki/parish", "license": {"name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"}}}}