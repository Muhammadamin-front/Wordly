h": "verb", "pronunciations": [{"type": "ipa", "text": "/ɡɹəʊv/", "tags": ["Received Pronunciation"]}, {"type": "ipa", "text": "/ɡɹoʊv/", "tags": ["US"]}], "forms": [{"word": "groves", "tags": ["present", "singular", "third-person"]}, {"word": "groving", "tags": ["participle", "present"]}, {"word": "groved", "tags": ["participle", "past"]}, {"word": "groved", "tags": ["past"]}], "senses": [{"definition": "To cultivate in groves; to grow naturally so as to form groves.", "tags": [], "examples": ["1984, Queensland Botany Bulletin, Issue 3, Department of Primary Industries, page 82,\nVirtually recognizable groving occurs in some A. aneura associations in the west. Further east some diffuse groving may occur, but is difficult to recognize without the benefit of aerial photographs."], "quotes": [{"text": "It is called \"Orchard Lake,\" from the fact, that near the centre is an island embracing an area of about fifty acres of land, well groved with different kinds of shrubbery; and near the centre of this island stand a number of aged apple-trees, planted, perhaps, a century since by the hand of some Indian.", "reference": "1841, Sapp R, “Orchard Lake”, in L. L. Hamline, editor, The Ladies Repository, Volume 1, page 165:"}, {"text": "The trees and shrubs are not arranged after any particular system, but are scattered or groved together in various parts of the garden.", "reference": "1822, Robert Chapman, The Topographical Picture of Glasgow in its Ancient and Modern State, 3rd edition, page 195:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "(forestry, of trees) To cultivate with periodic harvesting that also serves to create order (gaps and lines of trees) to facilitate further harvesting.", "tags": [], "examples": [], "quotes": [{"text": "In Herefordshire, especially on the northern and eastern sides, Oak timber abounds; and in many of the woods it is usual to have felling at periods varying from sixteen to twenty years; the straightest and handsomest are left for timber, or, as it is called, groved; and they are from time to time thinned, and a regular distance kept between them. The effect produced on these groved trees is, that from being exposed to air and sun, the rapidity of their growth is increased in bulk, height, and quality; and in sixty or eighty years they become valuable timber.", "reference": "1842 February 5, The Gardeners Chronicle, page 86:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}, {"definition": "To plough or gouge with lines.", "tags": [], "examples": ["1823, Instinct, in \"Sholto and Reuben Percy\" (Thomas Byerley), The Percy Anecdotes: Original and Select, Volume 9: Instinct—Ingenuity, page 138,\nVery frequently, however, to shorten the distance to the upper nurseries, where they have to take the eggs, they project an arch of about ten inches in length, and half an inch in breadth, groved or worked into steps, on its upper surface, to allow of a more easy passage."], "quotes": [{"text": "The floor of first story and piazza to be laid with Georgia pine, in narrow courses planed, groved and tongued, and laid in the best manner.", "reference": "1841, New York State Assembly, Documents of the Assembly of the State of New York, volume 2, page 14:"}], "synonyms": [], "antonyms": [], "translations": [], "subsenses": []}], "synonyms": ["groove"], "antonyms": []}], "source": {"url": "https://en.wiktionary.org/wiki/grove", "license": {"name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"}}}}