ess - no doubt remembering the grief that the Hymietown remark brought him during the 1984 campaign.", "reference": "1988 March 11, Don Wycliff, “The Editorial Notebook; The New Jesse Jackson”, in The New York Times, archived from the original on 30 Nov 2023, A, page 34:"}], "synonyms": [], "antonyms": [], "translations": [{"language": {"code": "br", "name": "Breton"}, "word": "evezhiadenn"}, {"language": {"code": "bg", "name": "Bulgarian"}, "word": "беле́жка"}, {"language": {"code": "bg", "name": "Bulgarian"}, "word": "забеле́жка"}, {"language": {"code": "bg", "name": "Bulgarian"}, "word": "комента́р"}, {"language": {"code": "cmn", "name": "Chinese Mandarin"}, "word": "備註 /备注"}, {"language": {"code": "cmn", "name": "Chinese Mandarin"}, "word": "發言 /发言"}, {"language": {"code": "cmn", "name": "Chinese Mandarin"}, "word": "評論 /评论"}, {"language": {"code": "cs", "name": "Czech"}, "word": "poznámka"}, {"language": {"code": "da", "name": "Danish"}, "word": "bemærkning"}, {"language": {"code": "da", "name": "Danish"}, "word": "kommentar"}, {"language": {"code": "eo", "name": "Esperanto"}, "word": "rimarko"}, {"language": {"code": "fi", "name": "Finnish"}, "word": "huomautus"}, {"language": {"code": "fr", "name": "French"}, "word": "remarque"}, {"language": {"code": "de", "name": "German"}, "word": "Bemerkung"}, {"language": {"code": "de", "name": "German"}, "word": "Anmerkung"}, {"language": {"code": "hu", "name": "Hungarian"}, "word": "megjegyzés"}, {"language": {"code": "hu", "name": "Hungarian"}, "word": "észrevétel"}, {"language": {"code": "it", "name": "Italian"}, "word": "battuta"}, {"language": {"code": "it", "name": "Italian"}, "word": "puntualizzazione"}, {"language": {"code": "ja", "name": "Japanese"}, "word": "注意書き"}, {"language": {"code": "ja", "name": "Japanese"}, "word": "但書き"}, {"language": {"code": "ja", "name": "Japanese"}, "word": "発言"}, {"language": {"code": "nb", "name": "Norwegian Bokmål"}, "word": "bemerkning"}, {"language": {"code": "nb", "name": "No