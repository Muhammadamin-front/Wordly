# Words.uz API — copy to .env and fill in.
ENVIRONMENT=development
SECRET_KEY=generate-with:python -c "import secrets; print(secrets.token_urlsafe(48))"

# Postgres in docker-compose; SQLite fallback works with no setup.
DATABASE_URL=postgresql+asyncpg://words:words@localhost:5432/words
# DATABASE_URL=sqlite+aiosqlite:///./words_dev.db

# Optional — in-memory rate limiting is used when unset.
REDIS_URL=redis://localhost:6379/0

FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Transactional email. Production requires Resend and a verified sender domain.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Wordly <noreply@words.uz>
EMAIL_REPLY_TO=support@words.uz

# Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID, type Web)
GOOGLE_CLIENT_ID=

# ElevenLabs TTS (natural pronunciation). Unset = browser voice fallback.
ELEVENLABS_API_KEY=

# Serper.dev (Google Images) — word-image enrichment script.
SERPER_API_KEY=

# Gemini — automatic fallback LLM for the AI tutor (silent failover).
GEMINI_API_KEY=

# AWS Bedrock (Converse API via a Bedrock API key). Region + model configurable.
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
