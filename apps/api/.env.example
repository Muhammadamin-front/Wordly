# Vocora API — copy to .env and fill in.
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Postgres in docker-compose; SQLite fallback works with no setup.
DATABASE_URL=postgresql+asyncpg://words:words@localhost:5432/words
# DATABASE_URL=sqlite+aiosqlite:///./words_dev.db

# Optional — in-memory rate limiting is used when unset.
REDIS_URL=redis://localhost:6379/0

# Only these reverse-proxy socket peers may supply X-Forwarded-For.
# Example: TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
TRUSTED_PROXY_CIDRS=

FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Transactional email. Production requires Resend and a verified sender domain.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Vocora <noreply@vocora.uz>
EMAIL_REPLY_TO=support@vocora.uz

# Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID, type Web).
# Must exactly match NEXT_PUBLIC_GOOGLE_CLIENT_ID from the web app.
GOOGLE_CLIENT_ID=

# Apple Sign in (Apple Developer -> Identifiers -> Services ID)
APPLE_CLIENT_ID=

# ElevenLabs TTS (natural pronunciation). Unset = browser voice fallback.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Serper.dev (Google Images) — word-image enrichment script.
SERPER_API_KEY=

# Gemini — automatic fallback LLM for the AI tutor (silent failover).
GEMINI_API_KEY=

# AWS Bedrock (Converse API via a Bedrock API key). Region + model configurable.
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=

# Payments. Checkout stays disabled until a provider has all required values.
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay
# Development/test only; production always disables sandbox activation.
PAYMENTS_SANDBOX=true

# Sentry error tracking. Unset = errors stay in application logs only.
# Project Settings -> Client Keys (DSN) on sentry.io.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
