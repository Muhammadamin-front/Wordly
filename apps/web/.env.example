# Vocora web — copy to .env.local
INTERNAL_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: enables the official Google Identity Services sign-in button.
# Use the Web application client ID (not the client secret). This value is public
# and is baked into the browser bundle at `next build` time.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional: enables the Apple sign-in button. The redirect URL must exactly match
# the Return URL registered for the Apple Services ID.
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=
# Optional: enables the GitHub sign-in button. Public client id only — the
# GitHub client secret lives in the API's .env and never reaches the browser.
# The callback URL is always {origin}/uz/auth/github/callback (fixed to the
# default locale — GitHub OAuth Apps register one callback URL, so this
# can't vary by the learner's current language). Register that exact URL as
# the OAuth App's Authorization callback URL.
NEXT_PUBLIC_GITHUB_CLIENT_ID=
# Optional: Sentry error tracking. DSNs are not secret — this is the same
# value baked into the browser bundle and read by instrumentation.ts /
# sentry.server.config.ts / sentry.edge.config.ts at runtime.
# Project Settings -> Client Keys (DSN) on sentry.io.
NEXT_PUBLIC_SENTRY_DSN=
# Optional, build-time only: enables source map upload so production stack
# traces show real file/line instead of minified output. Leave unset to skip.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
