{
  "name": "vocora-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:release": "npm run typecheck && node scripts/check-release-env.mjs && expo config --type public",
    "generate:api": "curl --fail http://127.0.0.1:8000/openapi.json -o openapi.json && openapi-typescript openapi.json -o src/api/schema.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@tanstack/react-query": "^5.66.8",
    "expo": "~54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.16",
    "expo-secure-store": "~15.0.7",
    "expo-speech": "~14.0.8",
    "expo-web-browser": "~15.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.2"
  }
}
