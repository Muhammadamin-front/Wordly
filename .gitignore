# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python (apps/api)
__pycache__/
*.pyc
.venv/
.venv-check/
*.db

# editor
.vscode/

# workspace node_modules anywhere
node_modules/
!.env.example

# API .env (keep real keys out of git)
apps/api/.env

# corpus pipeline cache (raw dictionary API responses)
apps/api/scripts/data/.enrich_cache/
apps/api/scripts/data/phrasal_idioms_ru_cache.json

*.bak

# local AI harness settings
.claude/settings.local.json
