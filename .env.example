# Root Docker Compose production environment. Copy to .env; never commit .env.
ENVIRONMENT=production
APP_VERSION=1.0.0

# Generate independently: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<generate-a-unique-secret>
FRONTEND_ORIGIN=https://vocora.uz
COOKIE_SECURE=true
# The proxy addresses whose X-Forwarded-For may be trusted. With Cloudflare
# Tunnel + Docker this is the bridge gateway, not 127.0.0.1. Never 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
API_BIND_HOST=127.0.0.1
API_PORT=8000
# workers x (DB_POOL_SIZE + DB_MAX_OVERFLOW) must stay under Postgres
# max_connections (100 by default). 2 workers = 30 connections.
UVICORN_WORKERS=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
WEB_PORT=3006

# Use URL-safe credentials. For an existing pgdata volume, rotate the database
# role deliberately before changing these values.
POSTGRES_USER=words
POSTGRES_PASSWORD=<generate-a-unique-database-password>
POSTGRES_DB=words
DATABASE_URL=postgresql+asyncpg://words:<same-password>@postgres:5432/words
POSTGRES_PORT=5433
# Written by deploy.sh on first run if absent; Redis holds only cache and
# ephemeral state, so rotating it costs a container restart.
REDIS_PASSWORD=
REDIS_URL=

EMAIL_PROVIDER=resend
RESEND_API_KEY=<from-resend>
EMAIL_FROM=Vocora <noreply@vocora.uz>
EMAIL_REPLY_TO=support@vocora.uz

NEXT_PUBLIC_API_URL=https://api.vocora.uz
NEXT_PUBLIC_SITE_URL=https://vocora.uz
INTERNAL_API_URL=http://api:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<web-oauth-client-id>
GOOGLE_CLIENT_ID=<same-web-oauth-client-id>
APPLE_CLIENT_ID=uz.vocora.mobile

# Dashboard-managed tunnel token. Keep this secret; it grants tunnel access.
CLOUDFLARE_TUNNEL_TOKEN=<from-cloudflare-add-a-replica>

PAYMENTS_SANDBOX=false
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
UZUM_TERMINAL_ID=
UZUM_API_KEY=
UZUM_WEBHOOK_SECRET=
UZUM_API_BASE_URL=https://developer.uzumbank.uz/api/v1

GEMINI_API_KEY=
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=
ELEVENLABS_API_KEY=
# Delivery rate, 0.7-1.2. Listening uses its own, slower value: the mock
# exam has to be transcribable, spelled-out names included.
ELEVENLABS_SPEED=1.0
ELEVENLABS_LISTENING_SPEED=0.88
DEEPGRAM_API_KEY=
SERPER_API_KEY=

# Bearer token for GET /api/v1/metrics (p95 latency, DB pool, queue depth).
# Leave empty and the route 404s.
METRICS_TOKEN=

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# 0..1, defaults to 0 (errors only, no performance tracing).
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
