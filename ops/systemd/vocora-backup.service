[Unit]
Description=Vocora encrypted off-site PostgreSQL backup
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/home/kitsune/Wordly
EnvironmentFile=/etc/vocora/backup.env
ExecStart=/home/kitsune/Wordly/ops/backup/backup-postgres.sh
NoNewPrivileges=true
PrivateTmp=true
