{
  "name": "vocora",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "overrides": {
    "@sentry/nextjs": {
      "next": "^16.3.0"
    }
  },
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "build:web": "npm run build --workspace web",
    "test:web": "npm run test --workspace web",
    "lint:web": "npm run lint --workspace web",
    "dev:api": "cd apps/api && .venv/bin/uvicorn app.main:app --reload --port 8000 --no-proxy-headers",
    "test:api": "cd apps/api && .venv/bin/python -m pytest",
    "test:release-preflight": "node --test scripts/release-preflight.test.mjs scripts/setup-production.test.mjs",
    "release:preflight": "node scripts/release-preflight.mjs"
  },
  "dependencies": {
    "expo": "^57.0.18"
  }
}
